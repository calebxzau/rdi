{
  "schemaVersion": 1,
  "id": "rdi",
  "version": "${version}",
  "name": "RDI",
  "description": "RDI Minecraft server support for Fabric 1.20.1",
  "authors": ["calebxzau"],
  "license": "GPL-3.0",
  "environment": "server",
  "accessWidener": "rdi.server.accesswidener",
  "entrypoints": {
    "server": [
      "calebxzau.rdi.mc.v20.fabric.RDIFabricServer"
    ]
  },
  "mixins": [
    "rdi.v20.server.mixins.json",
    "rdi.fabric.server.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-language-kotlin": ">=1.13",
    "fabric-lifecycle-events-v1": "2.2.23+1802ada577",
    "fabric-networking-api-v1": "1.3.15+0caff8d077",
    "minecraft": "1.20.1",
    "java": ">=25"
  }
}
