    @Deprecated("The local publish route was removed")
    suspend fun publish(request: Modpack2PublishRequest): Result<Uuid> =
        Result.failure(UnsupportedOperationException("Modpack2本地发布入口已移除，请选择平台安装包"))

    @Deprecated("The local publish retry route was removed")
    fun retrySubmissionTask(request: Modpack2PublishRequest): Task2 = removedLifecycleTask("重试发布整合包")

    @Deprecated("The local publish retry route was removed")
    suspend fun retrySubmission(request: Modpack2PublishRequest): Result<Uuid> =
        Result.failure(UnsupportedOperationException("Modpack2本地发布入口已移除，请选择平台安装包"))

    @Deprecated("The local publish route was removed")
