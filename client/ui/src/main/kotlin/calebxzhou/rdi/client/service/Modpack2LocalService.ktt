    private fun removedLifecycleTask(label: String): Task2 = Task2.Leaf(label) {
        throw UnsupportedOperationException("Modpack2旧入口已移除，请选择平台安装包")
    }

    private suspend fun <T> resultOf(block: suspend () -> T): Result<T> = try { Result.success(block()) } catch (cancelled: CancellationException) { throw cancelled } catch (error: Throwable) { Result.failure(error) }
}

data class Modpack2UploadArchive(
    val archive: Path,
    val preview: ModpackArchivePreview,
    val selectedOptionalFiles: Set<String> = emptySet(),
    val resolvedMods: Map<String, ResolvedArchiveMod> = emptyMap(),
)

/** Deprecated source model retained only for the unreachable removed Install screen. */
@Deprecated("Modpack2 local creation was removed; use Modpack2UploadArchive")
sealed interface Modpack2WorkspaceSource {
    data object Empty : Modpack2WorkspaceSource
    data class Directory(val directory: Path, val versionId: Uuid? = null) : Modpack2WorkspaceSource
    @Deprecated("Modpack2 local creation was removed; use Modpack2UploadArchive")
    data class Archive(
        val archive: Path,
        val preview: ModpackArchivePreview,
        val selectedOptionalFiles: Set<String> = emptySet(),
        val resolvedMods: Map<String, ResolvedArchiveMod> = emptyMap(),
    ) : Modpack2WorkspaceSource
}

private fun Modpack2Content.toContentRequest() = Mod(
    platform = platform.name.lowercase(), projectId = projectId, slug = slug, fileId = fileId, hash = hash,
).toClientContentRequest(targetRelativePath = targetPath ?: defaultContentPath(this), size = fileSize.takeIf { it >= 0L })

private fun defaultContentPath(content: Modpack2Content): String {
    val mod = Mod(content.platform.name.lowercase(), content.projectId, content.slug, content.fileId, content.hash)
    return when (content.type) {
        ContentType.Mod -> "mods/${mod.fileName}"
        ContentType.ShaderPack -> "shaderpacks/${mod.fileName}"
        ContentType.ResPack -> "resourcepacks/${mod.fileName}"
        ContentType.DataPack -> "datapacks/${mod.fileName}"
        ContentType.Other -> mod.fileName
    }
}

private fun Modpack2Loader.toModLoader() = when (this) {
    Modpack2Loader.Forge -> ModLoader.forge
    Modpack2Loader.NeoForge -> ModLoader.neoforge
}

@Deprecated("The local publish route was removed")
data class Modpack2PublishRequest(
    val localVersionId: Uuid,
    val modpackId: Uuid? = null,
    val baseVersionId: Uuid? = null,
    val versionName: String = "",
    val changelog: String = "",
    val serverMode: Modpack2ServerMode = Modpack2ServerMode.Generated,
    val modpack: Modpack2CreateModpackDto? = null,
    val sourceDirectory: Path? = null,
    val providedServerPack: Path? = null,
    val preview: Modpack2PackPreview? = null,
    val manualSideOverrides: Map<String, ContentSide> = emptyMap(),
    val explicitGithubSources: List<Modpack2ExplicitGithubSource> = emptyList(),
    val serverOnlyPaths: Set<String> = emptySet(),
    val manifest: Modpack2VersionManifestDto? = null,
    val allowRunning: Boolean = false,
)

@Deprecated("The local publish route was removed")
data class Modpack2PublishReceipt(val modpackId: Uuid, val versionId: Uuid, val status: Modpack2VersionStatus)

@Deprecated("The local server test route was removed")
data class Modpack2ServerTestRequest(
    val localVersionId: Uuid,
    val sourceDirectory: Path,
    val providedServerDirectory: Path?,
    val serverMode: Modpack2ServerMode,
    val processing: Modpack2ProcessingResult,
    val context: Task2Context?,
)

@Deprecated("The local server test route was removed")
fun interface Modpack2ServerTestRunner {
    suspend fun run(request: Modpack2ServerTestRequest): Result<Unit>
    companion object { val Rejecting = Modpack2ServerTestRunner { Result.failure(UnsupportedOperationException("本地服务端测试入口已移除")) } }
}

internal fun decodeManualSideOverrides(encoded: String): Map<String, ContentSide> = emptyMap()

internal fun encodeManualSideOverrides(overrides: Map<String, ContentSide>): String =
    overrides.entries.sortedBy { it.key }.joinToString("\n") { (path, side) -> "$path\t${side.name}" }

internal fun validateModpack2AppendPreflight(baseVersionId: Uuid, preflight: calebxzau.rdi.common.model.Modpack2AppendPreflightVo) {
    if (preflight.canAppend) require(preflight.currentVersionId.toString() == baseVersionId.toString()) { "整合包基础版本已过期，请刷新后重试" }
}

internal fun modpack2RawFilesFromArchive(archive: File): List<calebxzau.rdi.common.model.Modpack2RawFile> = emptyList()

suspend fun recoverModpack2Remapping(repository: LocalModpack2Repository, versionsDirectory: Path): Result<Unit> =
    Result.failure(UnsupportedOperationException("Modpack2重映射恢复已移除"))

suspend fun recoverModpack2Startup(repository: LocalModpack2Repository, versionsDirectory: Path, packProcessingDirectory: Path = ClientDirs.packProcDir.toPath()): Result<Unit> =
    Result.failure(UnsupportedOperationException("Modpack2发布恢复已移除"))

suspend fun clearUnreferencedModpack2PackProcessingFiles(repository: LocalModpack2Repository, packProcessingDirectory: Path): Result<Unit> =
    Result.failure(UnsupportedOperationException("Modpack2发布处理目录已移除"))

private fun Int.toMcVersion(): McVersion = McVersion.entries.firstOrNull { it.mcVer.substringAfter("1.").substringBefore('.').toIntOrNull() == this }
    ?: error("不支持的Minecraft版本: $this")

internal fun shouldRunModpack2ServerTest(
    serverMode: Modpack2ServerMode,
    ignoreModpackTest: Boolean,
): Boolean = serverMode == Modpack2ServerMode.Generated && !ignoreModpackTest
