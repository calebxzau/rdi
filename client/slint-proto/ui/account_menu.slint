import { Theme } from "theme.slint";
component AccountMenuItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    callback clicked();
    height: 36px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {root.clicked();}
    Rectangle { x: 4px; y: 2px; width: parent.width - 8px; height: parent.height - 4px; border-radius: 8px; background: touch.has-hover ? #0000000f : transparent; }
    Text { x: 12px; width: 24px; height: parent.height; text: root.glyph; font-family: Theme.symbols; font-size: 18px; color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; }
    Text { x: 44px; width: parent.width - self.x - 12px; height: parent.height; text: root.label; font-size: 14px; color: Theme.ink; vertical-alignment: center; }
    touch := TouchArea { mouse-cursor: pointer; clicked => {root.clicked();} }
}
/// Covers the window so that a click outside the panel closes it.
export component AccountMenu inherits Rectangle {
    in property <length> anchor-x;
    in property <length> anchor-y;
    callback dismiss();
    callback player-info();
    callback mail();
    callback settings();
    callback logout();
    TouchArea { clicked => {root.dismiss();} }
    Rectangle {
        width: 124px; height: menu-items.preferred-height;
        x: max(8px, min(root.anchor-x, root.width - self.width - 8px)); y: root.anchor-y;
        border-radius: 12px; background: #eef1f5;
        drop-shadow-blur: 10px; drop-shadow-offset-y: 3px; drop-shadow-color: #00000026;
        TouchArea {}
        menu-items := VerticalLayout {
            padding-top: 6px; padding-bottom: 6px;
            AccountMenuItem { glyph: "\u{f449}"; label: "个人信息"; clicked => {root.player-info();} }
            AccountMenuItem { glyph: "\u{f0e0}"; label: "邮箱"; clicked => {root.mail();} }
            AccountMenuItem { glyph: "\u{eb51}"; label: "设置"; clicked => {root.settings();} }
            AccountMenuItem { glyph: "\u{f2f5}"; label: "退出登录"; clicked => {root.logout();} }
        }
    }
}
