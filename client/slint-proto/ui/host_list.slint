import { GlassButton } from "glass_button.slint";
import { EmptyState, ErrorState, LoadingState, RScrollbar } from "shared.slint";
import { Theme } from "theme.slint";

export struct HostListRow {
    id: string,
    name: string,
    modpack: string,
    online-count: int,
    playable: bool,
}

export component HostList inherits Rectangle {
    in property <bool> enabled: true;
    in property <[HostListRow]> rooms;
    in property <bool> loading;
    in property <bool> starting-game;
    in property <string> error;
    out property <bool> near-end: list.rows-height + list.content-y <= list.height + list.row-height;
    callback retry();
    callback play(string);

    background: #f8f7eff7;
    border-radius: 24px;

    FocusScope {
        width: root.width; height: root.height; enabled: root.enabled;
        list := Flickable {
            x: 20px; y: 16px; width: parent.width - 52px; height: parent.height - self.y - 16px;
            property <length> row-height: 68px;
            property <length> rows-height: root.rooms.length * self.row-height;
            content-width: self.width;
            content-height: max(self.height, self.rows-height + (root.loading || root.error != "" ? 80px : 0px));

            for room[i] in root.rooms: Rectangle {
                y: i * list.row-height; width: list.width; height: list.row-height - 6px;
                visible: self.y + list.content-y + self.height > 0px && self.y + list.content-y < list.height;
                border-radius: 12px; background: #ecefe7;

                HorizontalLayout {
                    padding-left: 16px; padding-right: 12px; spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 1; alignment: center; spacing: 3px;
                        Text { text: room.name; min-width: 0px; overflow: elide; color: Theme.ink; font-size: 16px; font-weight: 600; }
                        Text { text: room.modpack; min-width: 0px; overflow: elide; color: #5b625b; font-size: 13px; }
                    }
                    Text {
                        width: 88px; text: room.online-count + "人在线"; color: #5b625b;
                        horizontal-alignment: right; vertical-alignment: center;
                    }
                    VerticalLayout {
                        width: 104px; alignment: center;
                        if room.playable: GlassButton { label: "进入房间"; enabled: !root.starting-game; clicked => {root.play(room.id);} }
                        if !room.playable: Text { text: "暂不可进入"; color: #5b625b; horizontal-alignment: center; }
                    }
                }
            }
            if root.rooms.length > 0 && root.loading: LoadingState { y: list.rows-height; width: list.width; height: 80px; }
            if root.rooms.length > 0 && root.error != "": ErrorState {
                y: list.rows-height; width: list.width; height: 80px; message: "房间加载失败"; retry => {root.retry();}
            }
        }
        RScrollbar {
            x: parent.width - 24px; y: list.y; width: 6px; height: list.height;
            viewport: list.height; extent: list.content-height; position: -list.content-y;
            scrolled(offset) => {list.content-y = -offset;}
        }
        if root.rooms.length == 0 && root.loading: LoadingState { x: list.x; y: list.y; width: list.width; height: list.height; }
        if root.rooms.length == 0 && root.error != "": ErrorState {
            x: list.x; y: list.y; width: list.width; height: list.height; message: "房间加载失败"; retry => {root.retry();}
        }
        if root.rooms.length == 0 && !root.loading && root.error == "": EmptyState {
            x: list.x; y: list.y; width: list.width; height: list.height; label: "暂无房间";
        }
    }
}
