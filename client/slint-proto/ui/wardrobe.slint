import { TextField } from "components/fields.slint";
import { CircleIconButton, GlassButton } from "components/glass_button.slint";
import { EmptyState, ErrorState, HttpImage, LoadingState, RScrollbar } from "components/shared.slint";
import { Theme } from "theme.slint";
import { Closet } from "closet.slint";

export struct WardrobeItem { id: int, name: string, likes: int, thumbnail: image, image-state: int }

export component WardrobeScreen inherits Rectangle {
    in property <bool> enabled: true;
    in property <[WardrobeItem]> items;
    in property <bool> loading;
    in property <string> error;
    out property <bool> near-end: grid.cards-height + grid.content-y <= grid.height + grid.row-height;
    private property <string> keyword;
    private property <bool> cape;
    callback back();
    callback search(string, bool);
    callback retry();

    function submit(cape: bool) {
        root.cape = cape;
        grid.content-y = 0px;
        root.search(root.keyword, cape);
    }

    background: #f8f7eff7;
    border-radius: 24px;
    FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height;
        enabled: root.enabled;
        HorizontalLayout { x: 20px; y: 16px; width: parent.width - 40px; height: 40px; spacing: 8px;
            VerticalLayout { alignment: center;
                CircleIconButton { glyph: "\u{f060}"; accessible-label: "返回"; clicked => {root.back();} }
            }
            Text { text: "衣柜"; color: Theme.ink; font-size: 22px; font-weight: 600; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            search-field := TextField { width: 220px; hint: "搜索皮肤或披风"; reserve-error: false; text <=> root.keyword; accepted => {root.submit(root.cape);} }
            VerticalLayout { alignment: center;
                CircleIconButton { glyph: "\u{f002}"; accessible-label: "搜索"; clicked => {root.submit(root.cape);} }
            }
            VerticalLayout { alignment: center;
                GlassButton { label: "皮肤"; checked: !root.cape; clicked => {if root.cape {root.submit(false);} } }
            }
            VerticalLayout { alignment: center;
                GlassButton { label: "披风"; checked: root.cape; clicked => {if !root.cape {root.submit(true);} } }
            }
            // U4e2: MojangSkinDialog.
            VerticalLayout { alignment: center;
                GlassButton { label: "导入正版皮肤"; glyph: "\u{f05b3}"; clicked => { Closet.action("mojang-open", ""); } }
            }
        }

        grid := Flickable {
            x: 20px; y: 72px; width: parent.width - 52px; height: parent.height - 88px;
            private property <length> gap: 10px;
            property <length> row-height: 174px;
            private property <int> columns: max(1, floor((self.width + self.gap) / (138px + self.gap)));
            private property <length> card-width: (self.width + self.gap) / self.columns - self.gap;
            property <length> cards-height: ceil(root.items.length / self.columns) * self.row-height;
            content-width: self.width;
            content-height: max(self.height, self.cards-height + (root.items.length > 0 && (root.loading || root.error != "") ? 80px : 0px));

            for item[i] in root.items: Rectangle {
                x: mod(i, grid.columns) * (grid.card-width + grid.gap); y: floor(i / grid.columns) * grid.row-height;
                width: grid.card-width; height: grid.row-height - grid.gap;
                visible: self.y + grid.content-y + self.height > 0px && self.y + grid.content-y < grid.height;
                background: card-touch.has-hover ? #f6f8f2 : #ecefe7; border-radius: 12px;
                accessible-role: button; accessible-label: item.name;
                accessible-action-default => { Closet.action("preview", item.id + "|" + item.name); }
                // U4e2: a card opens its preview (SkinPreviewScreen).
                card-touch := TouchArea { mouse-cursor: pointer; clicked => { Closet.action("preview", item.id + "|" + item.name); } }
                HttpImage { x: 8px; y: 6px; width: parent.width - 16px; height: parent.height - 42px;
                    background: transparent; source: item.thumbnail; image-state: item.image-state;
                }
                HorizontalLayout { x: 10px; y: parent.height - 31px; width: parent.width - 20px; height: 23px; spacing: 6px;
                    Text { text: item.name; min-width: 0px; horizontal-stretch: 1; overflow: elide;
                        color: Theme.ink; font-size: 13px; vertical-alignment: center;
                    }
                    Text { text: "♥" + item.likes; horizontal-stretch: 0;
                        color: #636b60; font-size: 12px; horizontal-alignment: right; vertical-alignment: center;
                    }
                }
            }
            if root.items.length > 0 && root.loading: LoadingState { x: 0px; y: grid.cards-height; width: grid.width; height: 72px; }
            if root.items.length > 0 && root.error != "": ErrorState {
                x: 0px; y: grid.cards-height; width: grid.width; height: 80px; message: root.error; retry => {root.retry();}
            }
        }
        RScrollbar { x: parent.width - 24px; y: grid.y; width: 6px; height: grid.height;
            viewport: grid.height; extent: grid.content-height; position: -grid.content-y;
            scrolled(offset) => {grid.content-y = -offset;}
        }
        if root.items.length == 0 && root.loading: LoadingState { x: grid.x; y: grid.y; width: grid.width; height: grid.height; }
        if root.items.length == 0 && root.error != "": ErrorState {
            x: grid.x; y: grid.y; width: grid.width; height: grid.height; message: root.error; retry => {root.retry();}
        }
        if root.items.length == 0 && !root.loading && root.error == "": EmptyState {
            x: grid.x; y: grid.y; width: grid.width; height: grid.height; label: root.cape ? "没有找到披风" : "没有找到皮肤";
        }
    }
}
