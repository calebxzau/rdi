import { CheckBox, ComboBox, ScrollView } from "std-widgets.slint";
import { TextField } from "components/fields.slint";
import { CircleIconButton, GlassButton } from "components/glass_button.slint";
import { EmptyState, ErrorState, LoadingState, RScrollbar } from "components/shared.slint";
import { NameInitial, NameInitialIcon } from "components/name_initial_icon.slint";
import { PlayerHead } from "components/player_head.slint";
import { Theme } from "theme.slint";

export struct PlazaFilters { category: int, minecraft: int, sort: int, mine: bool }
export struct PlazaCard {
    id: string, name: string, intro: string, metadata: string, play-count: string,
    initial: NameInitial, icon: image, has-icon: bool,
}
export struct PlazaPack { id: string, name: string, minecraft: string, author: string, intro: string, metadata: string, categories: string, has-source: bool }
// state: 0 可用, 1 构建中, 2 构建失败, 3 等待构建 (src/plaza.rs `status_state`).
export struct PlazaVersion { name: string, status: string, state: int, available: bool, metadata: string }
export struct PlazaMod { key: string, name: string, detail: string, icon: image, has-icon: bool, initial: string }

// `ModpackVersionCard`: the status icon and colour, then the version.
global VersionStatus {
    pure public function glyph(state: int) -> string {
        return state == 0 ? "\u{f0a50}" : state == 1 ? "\u{eeff}" : state == 2 ? "\u{ea87}" : "\u{e641}";
    }
    pure public function color(state: int) -> color {
        return state == 0 ? #446c49 : state == 1 ? #8a572b : state == 2 ? #ba3434 : #616c5f;
    }
}

component VersionCard inherits Rectangle {
    in property <PlazaVersion> version;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: root.version.status + " " + root.version.name;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    height: 44px;
    border-radius: 12px;
    border-width: 1px;
    border-color: focus.has-focus ? #446c49 : #cdd7c9;
    background: hit.has-hover ? #ffffff : #ffffffb8;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.clicked(); return accept; }
            return reject;
        }
    }
    HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 8px;
        Text { text: VersionStatus.glyph(root.version.state); font-family: Theme.symbols; font-size: 18px;
            color: VersionStatus.color(root.version.state); vertical-alignment: center; }
        Text { text: root.version.name; color: VersionStatus.color(root.version.state); font-size: 15px; font-weight: 600;
            vertical-alignment: center; overflow: elide; }
        Text { text: root.version.metadata; color: #616c5f; font-size: 13px; vertical-alignment: center;
            overflow: elide; horizontal-stretch: 1; }
    }
    hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

// `TinyClickCopyText("mid", id)`: clicking copies the id. Slint has no clipboard API in Rust,
// so a hidden TextInput selects the id and copies it.
component CopyText inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback copied();
    accessible-role: button;
    accessible-label: "复制" + root.label;
    width: shown.preferred-width;
    shown := Text { text: root.label + " " + root.value; color: #9aa197; font-size: 11px; vertical-alignment: center; }
    clip-source := TextInput { x: 0px; y: 0px; width: 1px; height: 1px; text: root.value; color: transparent; read-only: true; }
    TouchArea { mouse-cursor: pointer;
        clicked => { clip-source.select-all(); clip-source.copy(); clip-source.clear-selection(); root.copied(); }
    }
}

// One mod of the version page (`rememberModGridItems`): catalog icon, name and intro.
component ModCard inherits Rectangle {
    in property <PlazaMod> item;
    border-radius: 12px;
    background: #ffffffb0;
    accessible-role: text;
    accessible-label: root.item.name;
    if root.item.has-icon: Image { x: 10px; y: (parent.height - 40px) / 2; width: 40px; height: 40px; source: root.item.icon; image-fit: contain; }
    if !root.item.has-icon: Rectangle { x: 10px; y: (parent.height - 40px) / 2; width: 40px; height: 40px; border-radius: 8px; background: #dfe5d8;
        Text { text: root.item.initial; color: #446c49; font-size: 17px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
    Text { x: 60px; y: 8px; width: parent.width - self.x - 10px; text: root.item.name; color: Theme.ink; font-size: 14px; font-weight: 600; overflow: elide; }
    Text { x: 60px; y: 30px; width: parent.width - self.x - 10px; text: root.item.detail; color: #667064; font-size: 12px; overflow: elide; }
}

component PlazaPackCard inherits Rectangle {
    in property <PlazaCard> item;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: root.item.name;
    forward-focus: focus;
    border-radius: 16px;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? #446c49 : #dce2d8;
    background: hit.has-hover ? #ffffff : #ffffffbb;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.clicked(); return accept; }
            return reject;
        }
    }
    if root.item.has-icon: Image {
        x: 14px; y: 16px; width: 68px; height: self.width;
        source: root.item.icon; image-fit: contain;
    }
    if !root.item.has-icon: NameInitialIcon {
        x: 14px; y: 16px; width: 68px; height: self.width;
        initial: root.item.initial; border-radius: 8px; font-size: 28px;
    }
    VerticalLayout {
        x: 94px; y: 12px; width: parent.width - 108px; height: parent.height - 24px; spacing: 4px;
        Text { text: root.item.name; color: Theme.ink; font-size: 17px; font-weight: 600; overflow: elide; }
        Text { text: root.item.intro; color: #526050; font-size: 13px; wrap: word-wrap; overflow: elide; vertical-stretch: 1; }
        HorizontalLayout { spacing: 6px;
            Text { text: root.item.metadata; color: #616c5f; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
            Text { text: root.item.play-count; color: #446c49; font-size: 12px; }
        }
    }
    hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export component ModpackPlaza inherits Rectangle {
    in property <bool> enabled: true;
    in property <[PlazaCard]> cards;
    in property <[string]> categories;
    in property <[string]> minecraft;
    in property <[string]> sorts;
    in property <bool> loading;
    in property <bool> more;
    in property <string> error;
    in-out property <PlazaFilters> filters;
    in-out property <string> keyword;
    in-out property <length> scroll;
    // U4e3: 地图模板, for players with a Microsoft profile (Compose `loggedAccount.hasMsid`).
    in property <bool> base-worlds;
    callback action(string, string);

    background: #f8f7eff7;
    border-radius: 24px;
    FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height; enabled: root.enabled;
        HorizontalLayout {
            x: 20px; y: 16px; width: parent.width - 40px; height: 40px; spacing: 8px;
            VerticalLayout { alignment: center;
                CircleIconButton { glyph: "\u{f060}"; accessible-label: "返回"; clicked => { root.action("back", ""); } }
            }
            Text { text: "整合广场"; color: Theme.ink; font-size: 22px; font-weight: 600; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            TextField { width: 260px; hint: "搜索包名或简介"; reserve-error: false; text <=> root.keyword;
                accepted => { root.action("search", ""); }
            }
            VerticalLayout { alignment: center;
                CircleIconButton { glyph: "\u{f002}"; accessible-label: "搜索"; clicked => { root.action("search", ""); } }
            }
            if root.base-worlds: VerticalLayout { alignment: center;
                CircleIconButton { glyph: "\u{f279}"; accessible-label: "地图模板"; clicked => { root.action("base-worlds", ""); }
                    Tooltip { text: @markdown("地图模板"); } }
            }
        }
        HorizontalLayout {
            x: 20px; y: 66px; width: parent.width - 40px; height: 36px; spacing: 10px; alignment: start;
            ComboBox { width: 126px; model: root.categories; current-index <=> root.filters.category;
                accessible-label: "分类"; selected => { root.action("filter", ""); }
            }
            ComboBox { width: 128px; model: root.minecraft; current-index <=> root.filters.minecraft;
                accessible-label: "MC版本"; selected => { root.action("filter", ""); }
            }
            ComboBox { width: 126px; model: root.sorts; current-index <=> root.filters.sort;
                accessible-label: "排序"; selected => { root.action("filter", ""); }
            }
            VerticalLayout { alignment: center;
                CheckBox { text: "只看我的"; checked <=> root.filters.mine; toggled => { root.action("filter", ""); } }
            }
            if root.keyword != "" || root.filters.category != 0 || root.filters.minecraft != 0 || root.filters.sort != 0 || root.filters.mine:
                GlassButton { label: "清空筛选"; clicked => { root.action("clear", ""); } }
        }

        grid := Flickable {
            x: 20px; y: 114px; width: parent.width - 52px; height: parent.height - self.y - 16px;
            private property <length> gap: 10px;
            property <length> row-height: 124px;
            private property <int> columns: max(1, floor((self.width + self.gap) / (310px + self.gap)));
            private property <length> card-width: (self.width + self.gap) / self.columns - self.gap;
            property <length> cards-height: ceil(root.cards.length / self.columns) * self.row-height;
            content-width: self.width;
            content-height: max(self.height, self.cards-height + (root.error != "" ? 90px : root.more || root.loading ? 60px : 0px));
            content-y <=> root.scroll;

            for item[i] in root.cards: PlazaPackCard {
                x: mod(i, grid.columns) * (grid.card-width + grid.gap);
                y: floor(i / grid.columns) * grid.row-height;
                width: grid.card-width; height: grid.row-height - grid.gap;
                visible: self.y + grid.content-y + self.height > 0px && self.y + grid.content-y < grid.height;
                item: item; enabled: root.enabled; clicked => { root.action("detail", item.id); }
            }
            if root.cards.length > 0 && root.loading: LoadingState {
                x: 0px; y: grid.cards-height; width: grid.width; height: 60px; label: "正在加载更多…";
            }
            if root.cards.length > 0 && root.error != "": ErrorState {
                x: 0px; y: grid.cards-height; width: grid.width; height: 90px; message: root.error;
                retry => { root.action("more", ""); }
            }
            if root.more && !root.loading && root.error == "": GlassButton {
                x: (grid.width - self.width) / 2; y: grid.cards-height + 6px; width: 140px;
                label: "加载更多"; border-width: 1px; border-color: self.focused ? #446c49 : #cdd7c9;
                clicked => { root.action("more", ""); }
            }
        }
        RScrollbar {
            x: parent.width - 24px; y: grid.y; width: 6px; height: grid.height;
            viewport: grid.height; extent: grid.content-height; position: -grid.content-y;
            scrolled(offset) => { grid.content-y = -offset; }
        }
        if root.cards.length == 0 && root.loading: LoadingState { x: grid.x; y: grid.y; width: grid.width; height: grid.height; }
        if root.cards.length == 0 && root.error != "": ErrorState {
            x: grid.x; y: grid.y; width: grid.width; height: grid.height; message: root.error;
            retry => { root.action("more", ""); }
        }
        if root.cards.length == 0 && !root.loading && root.error == "" && !root.more: EmptyState {
            x: grid.x; y: grid.y; width: grid.width; height: grid.height; label: "没有找到符合条件的整合包";
        }
    }
}

export component ModpackDetails inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> version-page;
    in property <bool> loading;
    in property <string> error;
    in property <PlazaPack> pack;
    in property <[PlazaVersion]> versions;
    in property <PlazaVersion> version;
    in property <string> changelog;
    in property <string> base-world;
    // U4e3: the version's managers see 初始地图模板 with 配置初始地图 instead of base-world.
    in property <bool> base-world-manage;
    // The version page (`ModpackVersionInfoScreen` as a player sees it).
    in property <string> uploaded;
    in property <string> uploader-name;
    in property <image> uploader-head;
    in property <string> extras;
    in property <[PlazaMod]> mods;
    in property <int> mod-count;
    in property <bool> mods-hydrating;
    in-out property <string> mod-query;
    // 0 hidden, 1 安装, 2 安装中 (opens the task), 3 重新安装.
    in property <int> install-state;
    callback action(string, string);
    background: #f8f7eff7;
    border-radius: 24px;

    FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height; enabled: root.enabled;
        HorizontalLayout {
            x: 20px; y: 16px; width: parent.width - 40px; height: 40px; spacing: 8px;
            VerticalLayout { alignment: center;
                CircleIconButton { glyph: "\u{f060}"; accessible-label: "返回"; clicked => { root.action("back", ""); } }
            }
            Text {
                text: root.version-page ? root.pack.name + " · " + root.version.name : root.pack.name != "" ? root.pack.name : "整合包详情";
                color: Theme.ink; font-size: 22px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
            }
            if root.version-page && !root.loading && root.error == "": Text {
                text: root.version.status; color: VersionStatus.color(root.version.state); font-size: 15px; vertical-alignment: center;
            }
            // U4c1 D1(b): a room is created from a built version.
            if root.version-page && !root.loading && root.error == "": GlassButton {
                label: "创建房间"; glyph: "\u{f0c0}"; enabled: root.version.available; clicked => { root.action("create-room", ""); }
            }
            if root.version-page && root.install-state > 0 && !root.loading && root.error == "": GlassButton {
                label: root.install-state == 2 ? "安装中" : root.install-state == 3 ? "重新安装" : "安装";
                glyph: "\u{f019}"; filled: root.install-state == 1; clicked => { root.action("install", ""); }
            }
            if !root.version-page && root.pack.has-source: GlassButton {
                label: "打开原帖"; glyph: "\u{f08e}"; clicked => { root.action("source", ""); }
            }
        }
        if root.loading: LoadingState {
            x: 20px; y: 64px; width: parent.width - 40px; height: parent.height - 80px;
        }
        if root.error != "": ErrorState {
            x: 20px; y: 64px; width: parent.width - 40px; height: parent.height - 80px; message: root.error;
            retry => { root.action("retry-detail", ""); }
        }
        if !root.loading && root.error == "" && root.pack.name != "" && !root.version-page: ScrollView {
            x: 20px; y: 68px; width: parent.width - 40px; height: parent.height - self.y - 18px;
            content-height: pack-body.preferred-height;
            pack-body := VerticalLayout { width: parent.width; height: self.preferred-height; spacing: 10px; padding-right: 14px; padding-bottom: 6px;
                Text { text: root.pack.author == "" ? root.pack.metadata : root.pack.metadata + " · 作者 " + root.pack.author;
                    color: #526050; wrap: word-wrap; font-size: 14px;
                }
                if root.pack.categories != "": Text { text: root.pack.categories; color: #446c49; wrap: word-wrap; font-size: 13px; }
                HorizontalLayout { spacing: 10px; alignment: start;
                    Text { text: "请选择版本"; color: Theme.ink; font-size: 18px; font-weight: 600; vertical-alignment: center; }
                    if root.pack.minecraft != "": Text { text: root.pack.minecraft; color: #9aa197; font-size: 14px; vertical-alignment: center; }
                    CopyText { label: "mid"; value: root.pack.id; copied => { root.action("copied", "mid"); } }
                }
                if root.versions.length == 0: Text { text: "暂无可用版本"; color: #616c5f; font-size: 14px; }
                for version in root.versions: VersionCard {
                    max-width: 520px; version: version; enabled: root.enabled;
                    clicked => { root.action("version", version.name); }
                }
                Text { text: "简介"; color: Theme.ink; font-size: 18px; font-weight: 600; }
                Text { text: root.pack.intro != "" ? root.pack.intro : "无"; color: Theme.ink; wrap: word-wrap; font-size: 14px; }
            }
        }
        if !root.loading && root.error == "" && root.version-page: Rectangle {
            x: 20px; y: 68px; width: parent.width - 40px; height: parent.height - self.y - 18px;
            version-flick := Flickable {
                x: 0px; y: 0px; width: parent.width - 14px; height: parent.height;
                private property <length> gap: 10px;
                private property <length> row-height: 66px;
                private property <int> columns: max(1, floor((self.width + self.gap) / (260px + self.gap)));
                private property <length> card-width: (self.width + self.gap) / self.columns - self.gap;
                private property <length> grid-y: version-head.preferred-height;
                content-width: self.width;
                content-height: max(self.height, self.grid-y + ceil(root.mods.length / self.columns) * self.row-height + 6px);
                version-head := VerticalLayout { x: 0px; y: 0px; width: parent.width; height: self.preferred-height; spacing: 10px; padding-bottom: 12px;
                    HorizontalLayout { spacing: 6px; alignment: start; height: 28px;
                        Text { text: root.uploaded; color: #526050; font-size: 14px; vertical-alignment: center; }
                        Text { text: " by"; color: #526050; font-size: 14px; vertical-alignment: center; }
                        VerticalLayout { alignment: center; PlayerHead { width: 22px; height: 22px; source: root.uploader-head; } }
                        Text { text: root.uploader-name; color: Theme.ink; font-size: 14px; vertical-alignment: center; }
                    }
                    if root.base-world != "" && !root.base-world-manage: Text { text: root.base-world; color: #526050; font-size: 14px; }
                    if root.base-world-manage: HorizontalLayout { spacing: 10px; height: 40px;
                        Text { text: root.base-world; color: #526050; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                        VerticalLayout { alignment: center;
                            GlassButton { label: "配置初始地图"; glyph: "\u{ee69}"; clicked => { root.action("base-world-manage", ""); } }
                        }
                    }
                    if root.changelog != "": Text { text: "更新日志"; color: Theme.ink; font-size: 18px; font-weight: 600; }
                    if root.changelog != "": Text { text: root.changelog; color: Theme.ink; font-size: 14px; wrap: word-wrap; }
                    if root.extras != "": Text { text: "材质光影  " + root.extras; color: #526050; font-size: 13px; wrap: word-wrap; }
                    HorizontalLayout { spacing: 10px; height: 40px;
                        Text { text: "当前版本Mod(" + root.mod-count + ")"; color: Theme.ink; font-size: 18px; font-weight: 600; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        if root.mod-count > 0: TextField { width: 220px; hint: "搜索Mod"; reserve-error: false; text <=> root.mod-query;
                            edited => { root.action("mods-search", ""); }
                        }
                    }
                    if root.mods-hydrating: Text { text: root.mods.length == 0 ? "正在载入Mod信息..." : "正在补充Mod详细信息..."; color: #616c5f; font-size: 13px; }
                    if root.mods.length == 0 && !root.mods-hydrating: Text {
                        text: root.mod-count == 0 ? "当前版本没有Mod" : "没有匹配的Mod"; color: #616c5f; font-size: 14px;
                    }
                }
                for item[i] in root.mods: ModCard {
                    x: mod(i, version-flick.columns) * (version-flick.card-width + version-flick.gap);
                    y: version-flick.grid-y + floor(i / version-flick.columns) * version-flick.row-height;
                    width: version-flick.card-width; height: version-flick.row-height - version-flick.gap;
                    visible: self.y + version-flick.content-y + self.height > 0px && self.y + version-flick.content-y < version-flick.height;
                    item: item;
                }
            }
            RScrollbar {
                x: parent.width - 6px; y: 0px; width: 6px; height: parent.height;
                viewport: version-flick.height; extent: version-flick.content-height; position: -version-flick.content-y;
                scrolled(offset) => { version-flick.content-y = -offset; }
            }
        }
    }
}
