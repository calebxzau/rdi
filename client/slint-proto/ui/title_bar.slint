import { GlassButton } from "glass_button.slint";
import { HeadButton } from "shared.slint";
import { Theme } from "theme.slint";
import { WindowDotButton } from "window_dot_button.slint";
export component TitleBar inherits Rectangle {
    in property <string> player-name;
    in property <image> head;
    in property <bool> can-back;
    in property <bool> gallery-enabled;
    in property <bool> host-list-enabled;
    in property <bool> host-list-visible;
    callback navigate(string);
    callback action(int);
    callback stub(string);
    callback account();
    out property <length> account-x: head.absolute-position.x;
    height: 40px;
    background: #ffffff45;
    TouchArea { pointer-event(e) => {if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {root.action(0);}} double-clicked => {root.action(2);} }
    Rectangle { x: 14px; y: 8px; width: 24px; height: 24px; border-radius: 6px; clip: true;
        Image { width: 100%; height: 100%; source: @image-url("../../ui/assets/src/main/resources/icon.png"); }
    }
    Text { x: 46px; height: parent.height; text: "rdi"; color: Theme.ink; font-size: 18px; font-weight: 700; vertical-alignment: center; }
    GlassButton { x: 80px; y: 6px; width: 28px; height: 28px; circle: true; glyph: "\u{f015}"; clicked => {root.navigate("home");} }
    if root.can-back: GlassButton { x: 116px; y: 6px; width: 28px; height: 28px; circle: true; glyph: "\u{f060}"; accessible-label: "返回"; clicked => {root.navigate("back");} }
    if root.host-list-visible: Text {
        x: 154px; height: parent.height;
        text: "房间列表"; color: Theme.ink; font-size: 16px; font-weight: 600;
        vertical-alignment: center;
    }
    if root.host-list-enabled: GlassButton { x: 116px; y: 6px; width: 104px; height: 28px; label: "房间列表"; glyph: "\u{f03a}"; clicked => {root.navigate("host-list");} }
    if root.gallery-enabled: GlassButton { x: root.host-list-visible || root.host-list-enabled ? 228px : 154px; y: 6px; width: 96px; height: 28px; label: "组件画廊"; clicked => {root.navigate("gallery");} }
    HorizontalLayout { x: parent.width - 496px; y: 0px; width: 496px; height: 40px; spacing: 8px; padding: 0px; padding-right: 8px; alignment: end;
        // Padding centers the shorter items, since layouts place fixed-height items at the top.
        HorizontalLayout { spacing: 8px; padding-top: 6px; padding-bottom: 6px;
            GlassButton { width: 28px; height: 28px; circle: true; glyph: "m"; clicked => {root.stub("MC百科");} }
            GlassButton { width: 28px; height: 28px; circle: true; glyph: "\u{f0e0}"; clicked => {root.stub("邮件");} }
            GlassButton { width: 28px; height: 28px; circle: true; glyph: "\u{f11b}"; clicked => {root.navigate("console");} }
            GlassButton { width: 28px; height: 28px; circle: true; glyph: "\u{f0ae}"; clicked => {root.navigate("tasks");} }
            GlassButton { width: 28px; height: 28px; circle: true; glyph: "\u{eb51}"; clicked => {root.stub("设置");} }
        }
        HorizontalLayout { padding-top: 2px; padding-bottom: 2px;
            head := HeadButton { width: 116px; source: root.head; player-name: root.player-name; clicked => {root.account();} }
        }
        HorizontalLayout { spacing: 0px;
            WindowDotButton { dot-color: #febc2e; glyph: "\u{f2d1}"; label: "最小化"; clicked => {root.action(1);} }
            WindowDotButton { dot-color: #28c840; glyph: "\u{eab9}"; label: "最大化"; clicked => {root.action(2);} }
            WindowDotButton { dot-color: #ff5f57; glyph: "\u{f00d}"; label: "关闭"; clicked => {root.action(3);} }
        }
    }
}
