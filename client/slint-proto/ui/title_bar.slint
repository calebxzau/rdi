import { GlassButton } from "components/glass_button.slint";
import { HeadButton } from "components/shared.slint";
import { McpIcon } from "components/mcp_icon.slint";
import { Theme } from "theme.slint";
import { WindowDotButton } from "window_dot_button.slint";
export component TitleBar inherits Rectangle {
    in property <string> player-name;
    in property <image> head;
    in property <bool> can-back;
    in property <bool> gallery-enabled;
    in property <bool> host-list-visible;
    /// The AI assistant (launcher MCP): 0 off, 1 on, 2 failed.
    in property <int> mcp-state;
    /// The connected agent's brand or name; empty while none is connected.
    in property <string> mcp-agent;
    in property <image> mcp-agent-icon;
    in property <bool> mcp-agent-has-icon;
    private property <bool> mcp-capsule: root.mcp-state == 1 && root.mcp-agent != "";
    callback navigate(string);
    callback mcp();
    callback action(int);
    callback account();
    out property <length> account-x: head.absolute-position.x;
    out property <length> mcp-x: mcp-button.absolute-position.x;
    private property <length> nav-content-x: root.can-back ? 118px : 80px;
    height: 40px;
    background: #ffffff45;
    TouchArea { pointer-event(e) => {if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {root.action(0);}} double-clicked => {root.action(2);} }
    Rectangle { x: 14px; y: 8px; width: 24px; height: 24px; border-radius: 6px; clip: true;
        Image { width: 100%; height: 100%; source: @image-url("../assets/icon.png"); }
    }
    Text { x: 46px; height: parent.height; text: "rdi"; color: Theme.ink; font-size: 18px; font-weight: 700; vertical-alignment: center; }
    if root.can-back: GlassButton { x: 80px; y: 6px; width: 28px; height: 28px; circle: true; glyph: "\u{f060}"; accessible-label: "返回"; clicked => {root.navigate("back");} }
    if root.host-list-visible: Text {
        x: root.nav-content-x; height: parent.height;
        text: "房间列表"; color: Theme.ink; font-size: 16px; font-weight: 600;
        vertical-alignment: center;
    }
    if root.gallery-enabled: GlassButton { x: root.nav-content-x + (root.host-list-visible ? 74px : 0px); y: 6px; width: 96px; height: 28px; label: "组件画廊"; clicked => {root.navigate("gallery");} }
    HorizontalLayout { x: parent.width - 532px; y: 0px; width: 532px; height: 40px; spacing: 8px; padding: 0px; padding-right: 8px; alignment: end;
        // Padding centers the shorter items, since layouts place fixed-height items at the top.
        HorizontalLayout { spacing: 8px; padding-top: 6px; padding-bottom: 6px;
            // Round with the MCP mark; a capsule with the agent's brand while one is connected.
            mcp-button := Rectangle { width: root.mcp-capsule ? 27px + agent-pill.width + 3px : 28px; height: 28px;
                GlassButton { x: 0px; y: 0px; width: parent.width; height: 28px; circle: !root.mcp-capsule;
                    accessible-label: root.mcp-capsule ? "AI助手（已连接" + root.mcp-agent + "）" : root.mcp-state == 1 ? "AI助手（已开启）" : "AI助手";
                    clicked => {root.mcp();} }
                McpIcon { x: 4px; y: 4px; }
                agent-pill := Rectangle { x: 27px; y: 3px; height: 22px; width: agent-row.preferred-width; visible: root.mcp-capsule;
                    border-radius: 11px; background: #ffffff99; border-width: 1px; border-color: #0000001a;
                    agent-row := HorizontalLayout { padding-left: root.mcp-agent-has-icon ? 3px : 8px; padding-right: 8px; padding-top: 3px; padding-bottom: 3px; spacing: 4px;
                        if root.mcp-agent-has-icon: Rectangle { width: 16px; height: 16px; border-radius: 8px; clip: true;
                            Image { width: 16px; height: 16px; source: root.mcp-agent-icon; image-fit: cover; }
                        }
                        Text { text: root.mcp-agent; font-size: 12px; color: Theme.ink; vertical-alignment: center; }
                    }
                }
                if root.mcp-state == 1: Rectangle { x: 20px; y: 0px; width: 8px; height: 8px; border-radius: 4px; background: #28c840; border-width: 1px; border-color: #ffffffcc; }
            }
            GlassButton { width: 28px; height: 28px; circle: true; glyph: "\u{f11b}"; clicked => {root.navigate("console");} }
            GlassButton { width: 28px; height: 28px; circle: true; glyph: "\u{f0ae}"; clicked => {root.navigate("tasks");} }
        }
        HorizontalLayout { padding-top: 2px; padding-bottom: 2px;
            head := HeadButton { width: 116px; source: root.head; player-name: root.player-name; clicked => {root.account();} }
        }
        HorizontalLayout { spacing: 0px;
            WindowDotButton { dot-color: #febc2e; glyph: "\u{f2d1}"; label: "最小化"; clicked => {root.action(1);} }
            WindowDotButton { dot-color: #28c840; glyph: "\u{eab9}"; label: "最大化"; clicked => {root.action(2);} }
            WindowDotButton { dot-color: #ff5f57; glyph: "\u{f00d}"; label: "关闭"; clicked => {root.action(3);} }
        }
    }
}
