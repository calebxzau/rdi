    }
    SaveImportPage {
        x: (root.width - self.width) / 2; y: 56px; width: min(820px, root.width - 48px);
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: RoomPages.screen == 5 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    PlayerInfoPage {
        x: (root.width - self.width) / 2; y: 56px; width: min(820px, root.width - 48px);
        height: min(460px, root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px));
        visible: Account.screen == 1 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    MailPage {
        x: 24px; y: 56px; width: root.width - 48px;
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: Inbox.screen == 1 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    SettingsPage {
        x: (root.width - self.width) / 2; y: 56px; width: min(1000px, root.width - 48px);
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: Settings.screen == 1 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    ContentModsPage {
        x: 24px; y: 56px; width: root.width - 48px;
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: Content.screen == 1 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    ContentModDetailPage {
        x: (root.width - self.width) / 2; y: 56px; width: min(1100px, root.width - 48px);
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: Content.screen == 2 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    ContentResourcesPage {
        x: 24px; y: 56px; width: root.width - 48px;
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: Content.screen == 3 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    ContentResourceDetailPage {
        x: (root.width - self.width) / 2; y: 56px; width: min(1100px, root.width - 48px);
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: Content.screen == 4 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    BaseWorldListPage {
        x: (root.width - self.width) / 2; y: 56px; width: min(1100px, root.width - 48px);
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: Worlds.screen == 1 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    BaseWorldCreatePage {
        x: (root.width - self.width) / 2; y: 56px; width: min(720px, root.width - 48px);
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: Worlds.screen == 2 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    VersionBaseWorldPage {
        x: (root.width - self.width) / 2; y: 56px; width: min(1100px, root.width - 48px);
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: Worlds.screen == 3 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    SkinPreviewPage {
        x: (root.width - self.width) / 2; y: 56px; width: min(900px, root.width - 48px);
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: Closet.screen == 1 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    wardrobe-view := WardrobeScreen {
        x: 24px; y: 56px; width: root.width - 48px; height: root.height - self.y - (root.game-running ? 60px : 16px);
        visible: root.wardrobe-visible && !root.login-visible;
        enabled: !root.modal-open && root.activity-panel == 0;
        items: root.wardrobe-items; loading: root.wardrobe-loading; error: root.wardrobe-error;
        back => {root.navigate("back");}
        search(query, cape) => {root.wardrobe-search(query, cape);}
        retry => {root.wardrobe-retry();}
    }
    if root.selected == 1 && root.pack-screen == 0 && !root.wardrobe-visible && !root.host-list-visible && Content.screen == 0 && Worlds.screen == 0 && root.packs-error != "": GlassButton { x: 32px; y: root.height / 2; width: root.width - 64px; label: root.packs-error + " · 重试"; clicked => {root.pack-action("packs.refresh", "");} }
    if root.game-status != "": Text { x: 180px; y: parent.height - 34px; width: parent.width - 380px; text: root.game-status; overflow: elide; color: #30353c; }
    if root.game-running: GlassButton { x: parent.width - 180px; y: parent.height - 48px; width: 160px; label: "终止游戏"; clicked => { root.stop-games(); } }
    gallery-view := ComponentGallery {
        x: 0px; y: 40px; width: parent.width; height: parent.height - 40px; visible: root.gallery; enabled: !root.modal-open;
        page <=> root.gallery-page; head: root.gallery-image; image-state: root.gallery-image-state; items: root.gallery-items; tiles: root.gallery-tiles; logs: root.gallery-logs;
        selected-log: root.gallery-selected-log; all-logs: root.gallery-log-text; tasks: root.gallery-tasks; content-state <=> root.gallery-content-state;
        filter(q,k,d) => {root.gallery-filter(q,k,d);} notify(s) => {root.notify(s);} dialog => {root.gallery-dialog = true;}
        console-action(s) => {root.console-action(s);} select-log(i) => {root.select-log(i);} toggle-task(i) => {root.toggle-task(i);}
    }
    if root.activity-panel != 0: Rectangle { x: 0px; y: 40px; width: parent.width; height: parent.height - 40px; background: #0006;
        TouchArea { clicked => {root.activity-panel = 0;} }
        // Panels are centered with a margin; a TouchArea under each keeps clicks on empty panel space from closing it.
        if root.activity-panel == 1: Rectangle { width: min(1100px, parent.width - 48px); height: parent.height - 48px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: #fafcf4f2; border-radius: 24px;
            TouchArea {}
            HorizontalLayout { x: 16px; y: 12px; width: parent.width - 32px; height: 36px; spacing: 8px;
                Text { text: "控制台"; color: Theme.ink; font-size: 18px; font-weight: 600; vertical-alignment: center; }
                // `collapsed` marks the session whose log is shown.
                for session in root.activity-sessions: GlassButton { label: session.name; checked: session.collapsed; clicked => {root.pack-action("console.select",session.detail);} }
                Rectangle { horizontal-stretch: 1; }
                CircleIconButton { glyph: "\u{f021}"; accessible-label: "刷新"; clicked => {root.pack-action("console.subscribe", "");} }
                CircleIconButton { glyph: "\u{f00d}"; accessible-label: "关闭"; clicked => {root.activity-panel = 0;} }
            }
            Console { x: 4px; y: 52px; width: parent.width - 8px; height: parent.height - 68px; background: transparent; title-visible: false;
                lines: root.activity-logs; all-text: root.activity-log-text; selected-text: root.activity-selected-log;
                export => {root.pack-action("console.export", "");} clear => {root.pack-action("console.clear", "");} select-line(i) => {root.pack-action("console.line",i);}
            }
        }
        if root.activity-panel == 2: task-panel := Rectangle {
            property <bool> has-list: root.activity-task-list.length > 1;
            width: min(self.has-list ? 1000px : 760px, parent.width - 48px); height: min(520px, parent.height - 48px);
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: #fafcf4f2; border-radius: 24px;
            TouchArea {}
            if task-panel.has-list: ListView { x: 12px; y: 16px; width: 220px; height: parent.height - 32px;
                for task in root.activity-task-list: Rectangle { height: 44px;
                    GlassButton { width: task.collapsed ? parent.width - 40px : parent.width; height: 44px; label: task.name; clicked => {root.pack-action("tasks.watch",task.detail);} }
                    if task.collapsed: CircleIconButton { x: parent.width - 36px; y: 4px; glyph: "\u{f04d}"; accessible-label: "取消任务"; clicked => {root.pack-action("tasks.cancel",task.detail);} }
                }
            }
            TaskProgress { x: task-panel.has-list ? 236px : 0px; y: 0px; width: parent.width - self.x; height: parent.height; background: transparent;
                can-cancel: root.activity-can-cancel; cancel => {root.pack-action("tasks.cancel", "");}
                title: root.activity-title; message: root.activity-message; error: root.activity-error; fraction: root.activity-fraction; rows: root.activity-tasks;
                toggle(i) => {root.pack-action("tasks.toggle",i);} hidden => {root.activity-panel = 0;}
            }
        }
    }

    if root.account-menu && !root.login-visible: AccountMenu {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        anchor-x: title-bar.account-x; anchor-y: 44px;
        dismiss => {root.account-menu = false;}
        player-info => {root.account-menu = false; root.navigate("player-info");}
        mail => {root.account-menu = false; root.navigate("mail");}
        settings => {root.account-menu = false; root.navigate("settings");}
        logout => {root.account-menu = false; root.logout();}
    }
    if root.modal-open && !(Rooms.menu-open && !Rooms.dialog): Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: #0009; TouchArea {} }
    dialog := SharedDialog {
        width: min(480px, root.width - 48px);
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; visible: root.modal-open && !Rooms.modal && !RoomPages.modal && !SaveImport.modal && !Account.modal && !Inbox.modal && !Settings.modal && !Content.modal && !Worlds.modal && !Closet.modal && !root.login-register && !root.local-play && !root.pack-menu && !root.discard-options && !root.install-missing && !root.install-prompt && root.picked-candidates.length == 0;
        title: root.confirm-exit ? "退出启动器" : root.duplicate-host != "" ? "重复启动" : root.java-missing ? "缺少Java25" : root.action-error != "" ? "错误" : "与朋友一起冒险";
        message: root.confirm-exit ? (root.tasks-running ? "任务仍在进行，退出将终止任务和正在运行的游戏。是否继续？" : "游戏仍在运行，退出将终止游戏。是否继续？") : root.duplicate-host != "" ? "该整合包已在运行。再次启动可能造成存档、配置、日志或Mod缓存冲突。是否继续？" : root.java-missing ? "没找到可用的完整版64位JDK25，游戏需要它才能启动。是否自动下载安装？安装时需要允许管理员授权。" : root.action-error != "" ? root.action-error : "准备好探索Minecraft世界了吗？这段较长的中文说明会自动换行。";
        confirm-label: root.confirm-exit ? (root.tasks-running ? "终止并退出" : "终止游戏并退出") : root.duplicate-host != "" ? "继续启动" : root.java-missing ? "自动下载安装" : root.login-visible ? "明白" : "确定";
        cancel-visible: root.action-error == "";
        dismissed => {root.confirm-exit = false; root.duplicate-host = ""; root.java-missing = false; root.action-error = ""; root.gallery-dialog = false;}
        confirmed => {if root.confirm-exit {root.window-action(4);} else if root.duplicate-host != "" {root.confirm-duplicate();} else if root.java-missing {root.java-missing = false; root.pack-action("java.install", "");} else {root.action-error = ""; root.gallery-dialog = false;} }
    }
    if Rooms.modal: RoomDialogs { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    if RoomPages.modal: RoomPageDialogs { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    if SaveImport.modal: SaveImportDialogs { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    if Account.modal: AccountDialogs { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    if Inbox.modal: MailDialogs { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    if Settings.modal: SettingsDialogs { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    if Content.modal: ContentDialogs { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    if Worlds.modal: BaseWorldDialogs { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    if Closet.modal: ClosetDialogs { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    if root.login-register: Rectangle { x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; width: min(560px, root.width - 48px); height: 192px; border-radius: 24px; background: #f7faf0ff;
        VerticalLayout { padding: 24px; spacing: 16px;
            Text { text: "请选择注册方式"; font-size: 22px; color: Theme.ink; }
            HorizontalLayout { spacing: 8px;
                GlassButton { label: "用微软MC正版号注册"; filled: true; clicked => {root.login-register = false; Account.action("open-register", "msa");} }
                GlassButton { label: "用QQ邮箱注册"; clicked => {root.login-register = false; Account.action("open-register", "qq");} }
            }
            GlassButton { label: "取消"; clicked => {root.login-register = false;} }
        }
    }
    if root.pack-menu: Rectangle { x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; width: 360px; height: pack-menu-body.preferred-height; background: #f7faf0f5; border-radius: 24px;
        pack-menu-body := VerticalLayout { padding: 24px; spacing: 12px;
            Text { text: root.pack-name; font-size: 22px; color: Theme.ink; overflow: elide; }
            for label[i] in ["开始游戏", "高级", "目录"]: GlassButton { label: label; clicked => {root.pack-action("menu",i);} }
            if root.pack-has-detail: GlassButton { label: "详情"; clicked => {root.pack-action("menu", "3");} }
            if root.pack-has-detail: GlassButton { label: "导出"; clicked => {root.pack-menu = false; root.rdipack2("export", root.pack-selected-id);} }
            // U4e1: Compose's 模组/材质/光影 menu entries (ModpackContentType).
            HorizontalLayout { spacing: 8px;
                for entry in [{label: "模组", kind: "mods"}, {label: "材质", kind: "resourcepacks"}, {label: "光影", kind: "shaders"}]: GlassButton {
                    horizontal-stretch: 1; min-width: 0px; label: entry.label;
                    clicked => {root.pack-menu = false; Content.action("open-pack", entry.kind + "|" + root.pack-selected-id);}
                }
            }
            GlassButton { label: "取消"; clicked => {root.pack-action("menu", "5");} }
        }
    }
    if root.local-play: LocalPlay { x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; width: min(560px,root.width - 48px); height: min(self.preferred-height,root.height - 48px);
        name: root.pack-name; online-available: root.play-online-available; busy: root.play-busy; device-uri: root.play-device-uri; error: root.play-error; nonstandard-name: root.play-nonstandard-name;
        nickname <=> root.play-nickname; online <=> root.play-online;
        action(a,v) => {root.pack-action("play." + a,v);}
    }
    if root.discard-options: Rectangle { x: (root.width - 520px) / 2; y: (root.height - 200px) / 2; width: 520px; height: 200px; border-radius: 24px; background: #f7faf0f5;
        VerticalLayout { padding: 24px; spacing: 16px;
            Text { text: "未保存修改"; color: Theme.ink; font-size: 22px; }
            Text { text: "要保存修改后返回吗？"; color: Theme.ink; }
            HorizontalLayout { spacing: 8px;
                GlassButton { label: "保存并返回"; clicked => {root.discard-options = false; root.pack-action("options.saveBack", "");} }
                GlassButton { label: "放弃修改"; clicked => {root.discard-options = false; root.pack-action("options.discard", "");} }
                GlassButton { label: "取消"; clicked => {root.discard-options = false;} }
            }
        }
    }
    if root.install-missing: SharedDialog { x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; width: min(560px,root.width - 48px);
        height: min(root.height - 96px, 220px + min(root.install-missing-count, 12) * 18px);
        title: "有" + root.install-missing-count + "个文件无法自动下载"; message: root.install-missing-text; confirm-label: "继续导入";
        confirmed => {root.pack-action("installer.confirmMissing", "");} dismissed => {root.pack-action("installer.dismissMissing", "");}
    }
    if root.install-prompt: InstallPackDialog { x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; width: min(480px, root.width - 48px);
        pack-name: root.install-prompt-name; pack-title: root.install-prompt-title; detail: root.install-prompt-detail;
        step <=> root.install-prompt-step; include-extras <=> root.install-prompt-extras;
        init => {self.focus-dialog();}
        confirmed => {root.pack-action("install.confirm", "");} dismissed => {root.pack-action("install.cancel", "");}
        // 让朋友发我 / 从群文件下载 end in the 导入rdipack2 file picker.
        imported => {root.pack-action("install.cancel", ""); root.rdipack2("import", "");}
    }
    if root.picked-candidates.length > 0: Rectangle { x: (root.width - 560px) / 2; y: 80px; width: 560px; height: root.height - 160px; background: #f7faf0f5; border-radius: 24px;
        VerticalLayout { padding: 24px; spacing: 12px;
            Text { text: "选择要导入的版本"; font-size: 22px; color: Theme.ink; }
            ListView { for candidate in root.picked-candidates: GlassButton { height: 44px; label: candidate.name + " · " + candidate.detail; clicked => {root.pack-action("installer.pickedCandidate",candidate.index);} } }
            GlassButton { label: "取消"; clicked => {root.pack-action("installer.dismissCandidates", "");} }
        }
    }
    if Content.screen != 0 && Content.snack != "" && !root.login-visible: ContentSnack {
        x: (parent.width - self.width) / 2; y: parent.height - (root.game-running || root.game-status != "" ? 124px : 80px); width: min(560px, parent.width - 48px);
    }
    if root.toast-message != "": Toast { x: (parent.width - self.width) / 2; y: parent.height - 64px; width: min(560px, parent.width - 48px); message: root.toast-message; dismissed => {root.toast-message = "";} }
    proof := UiProof {
        visible: root.ui-proof; y: 40px; width: parent.width; height: parent.height - 40px;
        rows: root.proof-rows; busy: root.proof-busy; message: root.proof-message;
        panel-open <=> root.proof-panel-open; modal-open <=> root.proof-modal-open;
        freeze <=> root.proof-freeze;
        submit(u,p) => { root.proof-submit(u,p); }
        images => { root.proof-images(); }
        start => { root.proof-start(); }
        wheel(d) => { root.proof-wheel(d); }
    }
    // A maximized window cannot be resized, and its edges belong to the title controls.
    if !root.window-maximized: ResizeHandles { x: 0px; y: 0px; width: parent.width; height: parent.height; start(edge) => { root.window-resize(edge); } }

    }
    }
    if !root.window-maximized: window-outline := Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        border-radius: window-content.border-radius;
        border-width: 1px;
        border-color: #8b8980;
    }
}
