import { ModpackPlaza, ModpackDetails, PlazaCard, PlazaFilters, PlazaPack, PlazaVersion, PlazaMod } from "plaza.slint";
import { Rooms, RoomDetails, RoomForm, RoomDialogs, RoomInfo, RoomMember, RoomMenuEntry, RoomFriend, RoomFormView, RoomRule, RoomWorld } from "rooms.slint";
import { Account, AccountForm, PlayerInfoPage, AccountDialogs } from "account.slint";
import { Inbox, MailRow, MailPage, MailDialogs } from "mail.slint";
import { Settings, SettingsPage, SettingsDialogs } from "settings.slint";
import { RoomPages, RoomBackend, RoomWorldPage, RoomRollbackPage, RoomModsPage, RoomPageDialogs, RollbackRow, RoomModRow, GithubAssetRow } from "room_pages.slint";
import { SaveImport, SaveImportPage, SaveImportDialogs, SaveRoleRow, SaveMapRow } from "save_import.slint";
import { Closet, SkinPreviewPage, ClosetDialogs } from "closet.slint";
import { Worlds, WorldCard, WorldDetailRow, BaseWorldListPage, BaseWorldCreatePage, VersionBaseWorldPage, BaseWorldDialogs } from "base_world.slint";
import { Content, ContentCard, ContentFile, ResourceCard, GalleryItem, ContentModsPage, ContentResourcesPage, ContentModDetailPage, ContentResourceDetailPage, ContentDialogs, ContentSnack } from "content.slint";
export { Account, Inbox, MailRow, Settings, Rooms, RoomInfo, RoomMember, RoomMenuEntry, RoomFriend, RoomFormView, RoomRule, RoomWorld, RoomPages, RollbackRow, RoomModRow, GithubAssetRow, SaveImport, SaveRoleRow, SaveMapRow, Closet, Worlds, WorldCard, WorldDetailRow, Content, ContentCard, ContentFile, ResourceCard, GalleryItem }
export { LoginAccount, CandidateRow, OptionDraft, TileData, NameInitial, ProofRow, ProofRect, GlassShape, ContentRow, LogRow, TaskRow, WardrobeItem, HostListRow, PlazaCard, PlazaFilters, PlazaPack, PlazaVersion, PlazaMod }

component MenuTileGrid inherits TileGrid {
    row-major: true;
    captions: true;
    height: min(self.viewport-height, self.content-height);
    y: (self.viewport-height - self.height) / 2;
}

export component AppWindow inherits Window {
    in property <string> login-version;
    in property <bool> login-visible;
    in property <bool> login-busy;
    in-out property <string> login-account;
    in-out property <string> login-password;
    in-out property <string> login-saved-id;
    in-out property <bool> login-history;
    in-out property <bool> login-register;
    in property <[LoginAccount]> login-accounts;
    out property <GlassShape> login-panel: Account.page != 0 ? account-form.shape : login-view.shape;
    callback login-submit();
    callback login-select(string);
    out property <[GlassShape]> pack-panels: [install-view.shape, options-view.shape];
    in property <int> pack-screen;
    in property <[PlazaCard]> plaza-cards;
    in property <[string]> plaza-categories;
    in property <[string]> plaza-minecraft;
    in property <[string]> plaza-sorts;
    in property <bool> plaza-loading;
    in property <bool> plaza-more;
    in property <string> plaza-error;
    in-out property <PlazaFilters> plaza-filters;
    in-out property <string> plaza-query;
    in-out property <length> plaza-scroll;
    in property <bool> plaza-detail-loading;
    in property <string> plaza-detail-error;
    in property <PlazaPack> plaza-pack;
    in property <[PlazaVersion]> plaza-versions;
    in property <PlazaVersion> plaza-version;
    in property <string> plaza-changelog;
    in property <string> plaza-base-world;
    // U4e3: 初始地图模板 on the version page for its managers, and the plaza's 地图模板 button.
    in property <bool> plaza-base-world-manage;
    in property <bool> plaza-base-worlds;
    in property <string> plaza-uploaded;
    in property <image> plaza-author-head;
    in property <string> plaza-uploader-name;
    in property <image> plaza-uploader-head;
    in property <string> plaza-extras;
    in property <[PlazaMod]> plaza-mods;
    in property <int> plaza-mod-count;
    in property <bool> plaza-mods-hydrating;
    in-out property <string> plaza-mod-query;
    callback plaza-action(string, string);
    in property <bool> host-list-visible;
    in property <[HostListRow]> all-hosts;
    out property <bool> host-list-near-end: root.host-list-visible && host-list-view.near-end;
    out property <int> host-list-first-room: host-list-view.first-visible-room;
    out property <int> host-list-end-room: host-list-view.end-visible-room;
    changed host-list-near-end => { if root.host-list-near-end {root.load-host-page();} }
    changed host-list-visible => {root.scroll-changed();}
    changed host-list-first-room => {if root.host-list-visible {root.scroll-changed();}}
    changed host-list-end-room => {if root.host-list-visible {root.scroll-changed();}}
    callback load-host-page();
    in property <bool> wardrobe-visible;
    in property <[WardrobeItem]> wardrobe-items;
    in property <bool> wardrobe-loading;
    in property <string> wardrobe-error;
    out property <bool> wardrobe-near-end: wardrobe-view.near-end;
    callback wardrobe-search(string, bool);
    callback wardrobe-retry();
    callback pack-action(string,string);
    callback pack-filter(string,int,bool);
    callback pack-proof(string,string);
    in property <bool> install-editor;
    in property <bool> install-loading;
    in property <bool> install-scanning;
    in property <bool> install-can-submit;
    in property <bool> install-version-selectable;
    in property <bool> install-include-saves;
    in property <string> install-source;
    in property <string> install-source-directory;
    in property <string> install-error;
    in property <string> install-progress;
    in property <float> install-progress-fraction: -1;
    in property <string> install-name;
    in property <string> install-comment;
    in property <string> install-icon;
    in property <string> install-size;
    in property <[CandidateRow]> install-candidates;
    in property <[CandidateRow]> picked-candidates;
    in property <[string]> install-runtimes;
    in property <int> install-runtime-index;
    in property <[ContentRow]> install-contents;
    in-out property <bool> install-missing;
    // J4c room pack install confirmation; plaza-install: 0 hidden, 1 安装, 2 安装中, 3 重新安装.
    in-out property <bool> install-prompt;
    in property <string> install-prompt-name;
    in property <string> install-prompt-detail;
    // 「名称 版本」 for 请选择…下载方式; install-prompt-step is InstallPackDialog's `step`.
    in property <string> install-prompt-title;
    in-out property <int> install-prompt-step: 1;
    in-out property <bool> install-prompt-extras;
    in property <int> plaza-install;
    in property <string> install-missing-text;
    in property <int> install-missing-count;
    in property <string> pack-selected-id;
    in property <bool> pack-has-detail;
    in-out property <bool> pack-menu;
    in property <string> pack-name;
    // Name plus version name, as in the Compose options title.
    in property <string> options-title;
    in property <bool> options-loading;
    in property <bool> options-enabled;
    in property <bool> options-dirty;
    in property <string> options-error;
    in property <int> options-total-memory;
    in-out property <OptionDraft> options-draft;
    in-out property <bool> discard-options;
    in-out property <bool> local-play;
    in property <bool> play-online-available;
    in property <bool> play-busy;
    in property <string> play-device-uri;
    in property <string> play-error;
    in property <bool> play-nonstandard-name;
    in-out property <string> play-nickname;
    in-out property <bool> play-online;
    in property <bool> activity-can-cancel;
    in property <[TaskRow]> activity-tasks;
    in property <[LogRow]> activity-logs;
    in property <[CandidateRow]> activity-task-list;
    in property <[CandidateRow]> activity-sessions;
    in property <string> activity-title;
    in property <string> activity-message;
    in property <string> activity-error;
    in property <float> activity-fraction;
    in-out property <string> activity-selected-log;
    in property <string> activity-log-text;
    in property <bool> packs-loading;
    in property <string> packs-error;
    in property <bool> gallery-enabled;
    in property <bool> gallery;
    in property <bool> can-back;
    in-out property <int> gallery-page;
    in-out property <int> gallery-content-state;
    in property <image> gallery-image;
    in property <int> gallery-image-state;
    in property <[TileData]> gallery-tiles;
    out property <GlassShape> gallery-grid: gallery-view.tile-shape;
    out property <length> gallery-content-scroll: gallery-view.content-scroll;
    out property <length> gallery-scroll: gallery-view.tile-scroll;
    out property <int> gallery-hover: gallery-view.tile-hover;
    out property <int> gallery-pressed: gallery-view.tile-pressed;
    out property <float> gallery-press-scale: gallery-view.tile-scale;
    in property <[ContentRow]> gallery-items;
    in property <[LogRow]> gallery-logs;
    in property <string> gallery-selected-log;
    in property <string> gallery-log-text;
    in property <[TaskRow]> gallery-tasks;
    in-out property <bool> gallery-dialog;
    in-out property <string> toast-message;
    in-out property <int> activity-panel;
    callback navigate(string);
    callback gallery-filter(string,int,bool);
    callback notify(string);
    callback console-action(string);
    callback select-log(int);
    callback toggle-task(int);
    out property <bool> dialog-focused: dialog.contains-focus;
    out property <bool> gallery-password-revealed: gallery-view.password-revealed;
    out property <bool> modal-open: root.login-register || root.action-error != "" || root.duplicate-host != "" || root.java-missing || root.confirm-exit || root.gallery-dialog || root.local-play || root.pack-menu || root.discard-options || root.install-missing || root.install-prompt || root.picked-candidates.length > 0 || Rooms.modal || RoomPages.modal || SaveImport.modal || Account.modal || Inbox.modal || Settings.modal || Content.modal || Worlds.modal || Closet.modal;
    out property <[GlassShape]> menu-grids: [host-grid.shape, pack-grid.shape];
    out property <[GlassShape]> menu-pills: [tabs.shape, tabs.selected-shape, first-shortcut.shape, second-shortcut.shape, third-shortcut.shape];
    out property <[GlassShape]> glass-panels: [gallery-view.surfaces[0], gallery-view.surfaces[1], dialog.shape];
    in-out property <string> action-error;
    in-out property <string> duplicate-host;
    callback confirm-duplicate();
    // J5a: no usable Java 25 was found; confirming starts the automatic install.
    in-out property <bool> java-missing;
    in property <bool> game-running;
    in property <bool> tasks-running;
    in property <string> game-status;
    in-out property <bool> confirm-exit;
    callback stop-games();
    in property <bool> ui-proof;
    in property <[ProofRow]> proof-rows;
    in property <bool> proof-busy;
    in property <string> proof-message;
    in-out property <bool> proof-panel-open;
    in-out property <bool> proof-modal-open;
    in-out property <float> proof-freeze: -1;
    out property <ProofRect> proof-form: proof.form-rect;
    out property <ProofRect> proof-list: proof.list-rect;
    out property <ProofRect> proof-panel: proof.panel-rect;
    out property <ProofRect> proof-modal: proof.modal-rect;
    out property <float> proof-progress: proof.progress;
    out property <float> proof-scroll: proof.scroll;
    callback proof-submit(string, string);
    callback proof-images();
    callback proof-wheel(float);
    callback proof-start();
    title: "RDI Slint Prototype";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1280px; preferred-height: 720px; min-width: 800px; min-height: 600px;
    no-frame: true; background: transparent;
    default-font-family: "OPPO Sans 4.0";
    /// Background and glass, rendered with wgpu before each frame (see glass/mod.rs).
    in property <image> backdrop;
    /// The backdrop texture is redrawn in place, so its image never changes. Raising this tells
    /// Slint the pixels did; otherwise the rounded window's cached layer keeps showing old ones.
    in property <int> backdrop-revision;
    in property <[TileData]> hosts;
    in property <[TileData]> modpacks;
    in property <string> player-name: "未登录";
    in-out property <bool> account-menu;
    callback logout();
    in property <image> player-head;
    in property <string> error;
    in property <string> page-error;
    in property <bool> loading: true;
    in property <bool> loading-more;
    in property <int> selected: 0;
    in-out property <length> host-scroll: 0px;
    in-out property <length> modpack-scroll: 0px;
    in property <int> host-pressed: -1;
    in property <int> modpack-pressed: -1;
    in property <float> host-scale: 1;
    in property <float> modpack-scale: 1;
    out property <float> tab-position: root.selected;
    animate tab-position { duration: 350ms; easing: cubic-bezier(0.4,0,0.2,1); }
    out property <float> logical-width: self.width / 1px;
    out property <float> logical-height: self.height / 1px;
    property <length> room-grid-top: 116px;
    property <length> room-grid-space: self.height - root.room-grid-top - 86px;
    private property <length> parade-top: root.height - 56px;
    private property <length> shortcut-size: 48px;
    private property <length> menu-grid-bottom-limit: root.parade-top - root.shortcut-size - 12px;
    out property <length> menu-grid-height: min(476px, root.room-grid-space,
        root.menu-grid-bottom-limit - root.room-grid-top);
    private property <length> centered-grid-y: root.room-grid-top + (root.room-grid-space - root.menu-grid-height) / 2;
    out property <float> grid-y: min(root.centered-grid-y, root.menu-grid-bottom-limit - root.menu-grid-height) / 1px;
    out property <int> menu-grid-columns: host-grid.columns;
    out property <float> menu-grid-row-offset: host-grid.row-offset / 1px;
    out property <float> host-grid-last-row-offset: host-grid.last-row-offset / 1px;
    out property <float> pack-grid-last-row-offset: pack-grid.last-row-offset / 1px;
    out property <float> menu-grid-row-pitch: host-grid.row-pitch / 1px;
    out property <float> menu-grid-tile-size: host-grid.tile-size / 1px;
    callback window-action(int);
    callback window-resize(int);
    in property <bool> window-maximized;
    callback select-tab(int);
    callback tile-hover(int,int,bool);
    callback tile-press(int,int,bool);
    callback tile-action(int,int,bool);
    callback pill-press(int,bool,float,float);
    callback scroll-changed();
    callback retry();
    callback retry-page();
    callback stub(string);
    // 导入rdipack2 and the installed pack menu's 导出 (src/rdipack2_ui.rs).
    callback rdipack2(string, string);
    // A hidden room screen may hold the focus; Escape must still reach shell-focus.
    private property <int> room-screen: Rooms.screen * 10 + RoomPages.screen;
    changed room-screen => { if !root.modal-open {shell-focus.focus();} }
    // Room dialogs focus their own fields; Escape then reaches shell-focus, which dismisses them.
    changed modal-open => { if root.modal-open && !Rooms.modal && !RoomPages.modal && !SaveImport.modal && !Account.modal && !Inbox.modal && !Settings.modal && !Content.modal && !Worlds.modal && !Closet.modal {dialog.focus-dialog();} else if root.login-visible && Account.page == 0 {login-view.focus-account();} else {shell-focus.focus();} }
    changed logical-width => {root.scroll-changed();}
    changed logical-height => {root.scroll-changed();}
    forward-focus: shell-focus;
    window-content := Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        border-radius: root.window-maximized ? 0px : 24px;
        clip: true;
    shell-focus := FocusScope { x: 0px; y: 0px; width: root.width; height: root.height;
        key-pressed(e) => {
            if e.text == Key.Escape && root.account-menu {root.account-menu = false; return accept;}
            if e.text == Key.Escape {root.navigate("back"); return accept;}
            if e.modifiers.alt && e.text == Key.LeftArrow {root.navigate("back"); return accept;}
            return reject;
        }
    Image { width: parent.width; height: parent.height; source: root.backdrop-revision >= 0 ? root.backdrop : root.backdrop; image-fit: fill; }
    title-bar := TitleBar { y: 0px; width: parent.width; player-name: root.player-name; head: root.player-head; account => {if !root.login-visible {root.account-menu = !root.account-menu;}} action(a) => {root.window-action(a);} can-back: root.can-back; host-list-visible: root.host-list-visible; gallery-enabled: root.gallery-enabled; navigate(s) => {root.navigate(s);} }
    menu := FocusScope { x: 0px; y: 40px; width: parent.width; height: parent.height - 40px; visible: !root.login-visible && !root.ui-proof && !root.gallery && root.pack-screen == 0 && !root.wardrobe-visible && !root.host-list-visible && Rooms.screen == 0 && RoomPages.screen == 0 && Account.screen == 0 && Inbox.screen == 0 && Settings.screen == 0 && Content.screen == 0 && Worlds.screen == 0 && Closet.screen == 0; enabled: !root.modal-open && root.activity-panel == 0;
    tabs := GlassTabBar {
        x: (parent.width - self.width) / 2; y: 16px; tab-position: root.tab-position; selected: root.selected;
        select(t) => {root.select-tab(t);}
        press(i,on,x,y) => {root.pill-press(i,on,x,y);}
    }
    Rectangle { y: root.grid-y * 1px - 40px; width: parent.width; height: root.menu-grid-height; clip: true;
        // Tile leaves fade individually to avoid an offscreen layer for each grid.
        host-grid := MenuTileGrid {
            x: -root.tab-position * parent.width; width: parent.width; viewport-height: parent.height;
            visible: !root.loading && root.error == "" && root.tab-position < 1;
            tiles: root.hosts; scroll <=> root.host-scroll; fade: 1 - root.tab-position;
            pressed: root.host-pressed; press-scale: root.host-scale;
            hover(i,on) => {root.tile-hover(0,i,on);} press(i,on) => {root.tile-press(0,i,on);} action(i,r) => {root.tile-action(0,i,r);} moved => {root.scroll-changed();}
        }
        pack-grid := MenuTileGrid {
            x: (1 - root.tab-position) * parent.width; width: parent.width; viewport-height: parent.height;
            visible: !root.loading && !root.packs-loading && root.packs-error == "" && root.error == "" && root.tab-position > 0;
            tiles: root.modpacks; scroll <=> root.modpack-scroll; fade: root.tab-position;
            pressed: root.modpack-pressed; press-scale: root.modpack-scale;
            hover(i,on) => {root.tile-hover(1,i,on);} press(i,on) => {root.tile-press(1,i,on);} action(i,r) => {root.tile-action(1,i,r);} moved => {root.scroll-changed();}
        }
        if root.loading || (root.selected == 1 && root.packs-loading): Text { text: "正在加载…"; color: Theme.ink; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
        if !root.loading && root.error == "" && (root.selected == 0 ? root.hosts.length == 0 : !root.packs-loading && root.packs-error == "" && root.modpacks.length == 0): Text {
            text: root.selected == 1 ? "还没有整合包，去整合广场看看吧" : "暂无可游玩的房间";
            color: Theme.ink; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height;
        }
        if root.error != "": VerticalLayout { padding: 64px; alignment: center; spacing: 16px;
            Text { text: root.error; wrap: word-wrap; horizontal-alignment: center; color: #902020; }
            GlassButton { width: 120px; label: "重试"; glyph: "\u{f021}"; clicked => {root.retry();} }
        }
    }
    home-shortcuts := Rectangle {
        private property <bool> modpacks: root.selected == 1;
        private property <length> step: root.shortcut-size + 16px;
        private property <length> grid-bottom: self.modpacks
            ? pack-grid.absolute-position.y + pack-grid.height
            : host-grid.absolute-position.y + host-grid.height;
        x: (parent.width - self.width) / 2;
        y: (self.grid-bottom + root.parade-top - self.height) / 2 - menu.absolute-position.y;
        width: root.shortcut-size + 2 * self.step;
        height: root.shortcut-size;

        first-shortcut := CircleIconButton {
            x: 0px;
            height: root.shortcut-size;
            glyph: home-shortcuts.modpacks ? "\u{f19d5}" : "\u{f03a}";
            accessible-label: home-shortcuts.modpacks ? "整合广场" : "房间列表";
            enabled: menu.enabled && !root.account-menu;
            clicked => {root.navigate(home-shortcuts.modpacks ? "plaza" : "host-list");}
            accessible-action-default => {if self.enabled {self.clicked();}}
            press(on,x,y) => {root.pill-press(2,on,x,y);}
            Tooltip { text: home-shortcuts.modpacks ? @markdown("整合广场") : @markdown("房间列表"); }
        }
        second-shortcut := CircleIconButton {
            x: home-shortcuts.step;
            height: root.shortcut-size;
            glyph: home-shortcuts.modpacks ? "\u{eaef}" : "\u{ee1c}";
            accessible-label: home-shortcuts.modpacks ? "整合包本地安装" : "衣柜";
            enabled: first-shortcut.enabled;
            clicked => {root.navigate(home-shortcuts.modpacks ? "install" : "wardrobe");}
            accessible-action-default => {if self.enabled {self.clicked();}}
            press(on,x,y) => {root.pill-press(3,on,x,y);}
            Tooltip { text: home-shortcuts.modpacks ? @markdown("整合包本地安装") : @markdown("衣柜"); }
        }
        third-shortcut := CircleIconButton {
            x: 2 * home-shortcuts.step;
            height: root.shortcut-size;
            glyph: home-shortcuts.modpacks ? "\u{f019}" : "\u{f067}";
            accessible-label: home-shortcuts.modpacks ? "导入rdipack2" : "创建房间";
            enabled: first-shortcut.enabled;
            clicked => {if home-shortcuts.modpacks {root.rdipack2("import", "");} else {Rooms.action("guide", "");} }
            accessible-action-default => {if self.enabled {self.clicked();}}
            press(on,x,y) => {root.pill-press(4,on,x,y);}
            Tooltip { text: home-shortcuts.modpacks ? @markdown("导入rdipack2") : @markdown("创建房间"); }
        }
    }
    if menu.enabled && !root.account-menu && (root.selected == 0
        ? root.tab-position == 0 && host-grid.has-hovered-tile
        : root.tab-position == 1 && pack-grid.has-hovered-tile): CardHint {
        modpack: root.selected == 1;
        tile: self.modpack ? pack-grid.hovered-tile : host-grid.hovered-tile;
        anchor-x: (self.modpack ? pack-grid.hovered-center-x : host-grid.hovered-center-x) - menu.absolute-position.x;
        anchor-top: (self.modpack ? pack-grid.hovered-top-y : host-grid.hovered-top-y) - menu.absolute-position.y;
        anchor-bottom: (self.modpack ? pack-grid.hovered-bottom-y : host-grid.hovered-bottom-y) - menu.absolute-position.y;
        available-width: menu.width;
        available-height: home-shortcuts.y;
    }
    }
    login-view := LoginScreen { visible: root.login-visible && Account.page == 0; enabled: !root.modal-open;
        x: (root.width - self.width) / 2; y: 40px + (root.height - 40px - self.height) / 2;
        width: min(480px, root.width - 32px); height: min(520px, root.height - 72px);
        version: root.login-version;
        account <=> root.login-account; password <=> root.login-password; saved-id <=> root.login-saved-id;
        history <=> root.login-history; busy: root.login-busy; accounts: root.login-accounts;
        submit => {root.login-submit();} select(id) => {root.login-select(id);}
        register => {root.login-register = true;} forgot => {Account.action("open-reset", "");}
    }
    account-form := AccountForm { visible: root.login-visible && Account.page != 0; enabled: !root.modal-open;
        x: (root.width - self.width) / 2; y: 40px + (root.height - 40px - self.height) / 2;
        width: min(560px, root.width - 32px); height: min(640px, root.height - 72px);
    }
    install-view := LocalModpackInstall { visible: root.pack-screen == 1;
        x: root.width * 0.05; y: 40px + (root.height - 40px) * 0.05; width: root.width * 0.9; height: (root.height - 40px) * 0.9; enabled: !root.modal-open && root.activity-panel == 0;
        editor: root.install-editor; loading: root.install-loading; scanning: root.install-scanning;
        can-submit: root.install-can-submit; version-selectable: root.install-version-selectable; include-saves: root.install-include-saves;
        source: root.install-source; source-directory: root.install-source-directory; error: root.install-error; progress: root.install-progress; progress-fraction: root.install-progress-fraction;
        name: root.install-name; comment: root.install-comment; icon-url: root.install-icon; size-text: root.install-size; missing-count: root.install-missing-count;
        candidates: root.install-candidates; runtimes: root.install-runtimes; runtime-index: root.install-runtime-index; contents: root.install-contents;
        action(a,v) => {if a == "back" {root.navigate("back");} else {root.pack-action("installer." + a,v);} }
        filter(q,k,d) => {root.pack-filter(q,k,d);}
    }
    options-view := ModpackLocalAdvanceOption { visible: root.pack-screen == 2;
        x: root.width * 0.05; y: 40px + (root.height - 40px) * 0.05; width: root.width * 0.9; height: (root.height - 40px) * 0.9; enabled: !root.modal-open && root.activity-panel == 0;
        title: root.options-title; loading: root.options-loading; enabled-controls: root.options-enabled;
        error: root.options-error; total-memory: root.options-total-memory; draft <=> root.options-draft;
        action(a,v) => {if a == "back" {root.navigate("back");} else {root.pack-action("options." + a,v);} }
    }
    ModpackPlaza {
        x: 24px; y: 56px; width: root.width - 48px; height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: root.pack-screen == 3 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
        cards: root.plaza-cards; categories: root.plaza-categories; minecraft: root.plaza-minecraft; sorts: root.plaza-sorts;
        loading: root.plaza-loading; more: root.plaza-more; error: root.plaza-error;
        keyword <=> root.plaza-query; filters <=> root.plaza-filters; scroll <=> root.plaza-scroll; base-worlds: root.plaza-base-worlds;
        action(a, v) => { if a == "back" { root.navigate("back"); } else { root.plaza-action(a, v); } }
    }
    ModpackDetails {
        x: (root.width - self.width) / 2; y: 56px; width: min(920px, root.width - 48px);
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: (root.pack-screen == 4 || root.pack-screen == 5) && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
        version-page: root.pack-screen == 5;
        loading: root.plaza-detail-loading; error: root.plaza-detail-error; pack: root.plaza-pack; author-head: root.plaza-author-head;
        versions: root.plaza-versions; version: root.plaza-version; changelog: root.plaza-changelog;
        base-world: root.plaza-base-world; base-world-manage: root.plaza-base-world-manage; install-state: root.plaza-install;
        uploaded: root.plaza-uploaded; uploader-name: root.plaza-uploader-name; uploader-head: root.plaza-uploader-head;
        extras: root.plaza-extras; mods: root.plaza-mods; mod-count: root.plaza-mod-count;
        mods-hydrating: root.plaza-mods-hydrating; mod-query <=> root.plaza-mod-query;
        action(a, v) => { if a == "back" { root.navigate("back"); } else { root.plaza-action(a, v); } }
    }
    host-list-view := HostList {
        x: 24px; y: 56px; width: root.width - 48px; height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: root.host-list-visible && !root.login-visible;
        enabled: !root.modal-open && root.activity-panel == 0;
        rooms: root.all-hosts; loading: root.loading-more || (root.loading && root.all-hosts.length == 0);
        error: root.error != "" ? root.error : root.page-error;
        retry => {if root.error != "" {root.retry();} else {root.retry-page();}}
        open(id) => {Rooms.action("open", id);}
    }
    RoomDetails {
        x: (root.width - self.width) / 2; y: 56px; width: min(1100px, root.width - 48px);
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: Rooms.screen == 1 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    RoomForm {
        x: (root.width - self.width) / 2; y: 56px; width: min(1180px, root.width - 48px);
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: Rooms.screen == 2 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    RoomBackend {
        x: (root.width - self.width) / 2; y: 56px; width: min(1100px, root.width - 48px);
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: RoomPages.screen == 1 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    RoomWorldPage {
        x: (root.width - self.width) / 2; y: 56px; width: min(640px, root.width - 48px);
        height: min(460px, root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px));
        visible: RoomPages.screen == 2 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    RoomRollbackPage {
        x: (root.width - self.width) / 2; y: 56px; width: min(820px, root.width - 48px);
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: RoomPages.screen == 3 && !root.login-visible;
        enabled: self.visible && !root.modal-open && root.activity-panel == 0;
    }
    RoomModsPage {
        x: 24px; y: 56px; width: root.width - 48px;
        height: root.height - self.y - (root.game-running || root.game-status != "" ? 60px : 16px);
        visible: RoomPages.screen == 4 && !root.login-visible;
