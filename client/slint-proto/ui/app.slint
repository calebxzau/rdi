import "../../ui/assets/fonts/src/main/resources/assets/fonts/1oppo.ttf";
import "../../ui/assets/fonts/src/main/resources/assets/fonts/symbolsnerdfont.ttf";
import { LoginScreen, LoginAccount } from "login.slint";
import { LocalModpackInstall, ModpackLocalAdvanceOption, LocalPlay, CandidateRow, OptionDraft } from "packs.slint";
import { GlassSurface } from "surfaces.slint";
import { ListView } from "std-widgets.slint";
import { ComponentGallery } from "gallery.slint";
import { GlassShape } from "surfaces.slint";
import { SharedDialog, Toast, ContentRow, LogRow, TaskRow } from "shared.slint";
import { Console, TaskProgress } from "activity.slint";
import { TileData, Theme } from "theme.slint";
import { TitleBar } from "title_bar.slint";
import { AccountMenu } from "account_menu.slint";
import { TileGrid } from "tile_grid.slint";
import { GlassTabBar } from "glass_tab_bar.slint";
import { GlassButton, CircleIconButton } from "glass_button.slint";
import { UiProof, ProofRow, ProofRect } from "ui_proof.slint";
import { ResizeHandles } from "resize_handles.slint";
export { LoginAccount, CandidateRow, OptionDraft, TileData, ProofRow, ProofRect, GlassShape, ContentRow, LogRow, TaskRow }
export component AppWindow inherits Window {
    in property <string> login-version;
    in property <bool> login-visible;
    in property <bool> login-busy;
    in-out property <string> login-account;
    in-out property <string> login-password;
    in-out property <string> login-saved-id;
    in-out property <bool> login-history;
    in-out property <bool> login-register;
    in property <[LoginAccount]> login-accounts;
    out property <GlassShape> login-panel: login-view.shape;
    callback login-submit();
    callback login-select(string);
    out property <[GlassShape]> pack-panels: [install-view.shape, options-view.shape];
    in property <int> pack-screen;
    callback pack-action(string,string);
    callback pack-filter(string,int,bool);
    callback pack-proof(string,string);
    in property <bool> install-editor;
    in property <bool> install-loading;
    in property <bool> install-scanning;
    in property <bool> install-can-submit;
    in property <bool> install-version-selectable;
    in property <bool> install-include-saves;
    in property <string> install-source;
    in property <string> install-source-directory;
    in property <string> install-error;
    in property <string> install-progress;
    in property <float> install-progress-fraction: -1;
    in property <string> install-name;
    in property <string> install-comment;
    in property <string> install-icon;
    in property <string> install-size;
    in property <[CandidateRow]> install-candidates;
    in property <[CandidateRow]> picked-candidates;
    in property <[string]> install-runtimes;
    in property <int> install-runtime-index;
    in property <[ContentRow]> install-contents;
    in-out property <bool> install-missing;
    in property <string> install-missing-text;
    in property <int> install-missing-count;
    in property <string> pack-selected-id;
    in-out property <bool> pack-menu;
    in property <string> pack-name;
    // Name plus version name, as in the Compose options title.
    in property <string> options-title;
    in property <bool> options-loading;
    in property <bool> options-enabled;
    in property <bool> options-dirty;
    in property <string> options-error;
    in property <int> options-total-memory;
    in-out property <OptionDraft> options-draft;
    in-out property <bool> discard-options;
    in-out property <bool> local-play;
    in property <bool> play-online-available;
    in property <bool> play-busy;
    in property <string> play-device-uri;
    in property <string> play-error;
    in property <bool> play-nonstandard-name;
    in-out property <string> play-nickname;
    in-out property <bool> play-online;
    in property <[TaskRow]> activity-tasks;
    in property <[LogRow]> activity-logs;
    in property <[CandidateRow]> activity-task-list;
    in property <[CandidateRow]> activity-sessions;
    in property <string> activity-title;
    in property <string> activity-message;
    in property <string> activity-error;
    in property <float> activity-fraction;
    in-out property <string> activity-selected-log;
    in property <string> activity-log-text;
    in property <bool> packs-loading;
    in property <string> packs-error;
    in property <bool> gallery-enabled;
    in property <bool> gallery;
    in property <bool> can-back;
    in-out property <int> gallery-page;
    in-out property <int> gallery-content-state;
    in property <image> gallery-image;
    in property <int> gallery-image-state;
    in property <[TileData]> gallery-tiles;
    out property <GlassShape> gallery-grid: gallery-view.tile-shape;
    out property <length> gallery-content-scroll: gallery-view.content-scroll;
    out property <length> gallery-scroll: gallery-view.tile-scroll;
    out property <int> gallery-hover: gallery-view.tile-hover;
    out property <int> gallery-pressed: gallery-view.tile-pressed;
    out property <float> gallery-press-scale: gallery-view.tile-scale;
    in property <[ContentRow]> gallery-items;
    in property <[LogRow]> gallery-logs;
    in property <string> gallery-selected-log;
    in property <string> gallery-log-text;
    in property <[TaskRow]> gallery-tasks;
    in-out property <bool> gallery-dialog;
    in-out property <string> toast-message;
    in-out property <int> activity-panel;
    callback navigate(string);
    callback gallery-filter(string,int,bool);
    callback notify(string);
    callback console-action(string);
    callback select-log(int);
    callback toggle-task(int);
    out property <bool> dialog-focused: dialog.contains-focus;
    out property <bool> gallery-password-revealed: gallery-view.password-revealed;
    out property <bool> modal-open: root.login-register || root.action-error != "" || root.duplicate-host != "" || root.confirm-exit || root.gallery-dialog || root.local-play || root.pack-menu || root.discard-options || root.install-missing || root.picked-candidates.length > 0;
    out property <[GlassShape]> menu-grids: [host-grid.shape, pack-grid.shape];
    out property <[GlassShape]> menu-pills: [tabs.shape, tabs.selected-shape, create.shape, others.shape, plaza.shape, install.shape, import-pack.shape];
    out property <[GlassShape]> glass-panels: [gallery-view.surfaces[0], gallery-view.surfaces[1], dialog.shape];
    in-out property <string> action-error;
    in-out property <string> duplicate-host;
    callback confirm-duplicate();
    in property <bool> game-running;
    in property <bool> tasks-running;
    in property <string> game-status;
    in-out property <bool> confirm-exit;
    callback stop-games();
    in property <bool> ui-proof;
    in property <[ProofRow]> proof-rows;
    in property <bool> proof-busy;
    in property <string> proof-message;
    in-out property <bool> proof-panel-open;
    in-out property <bool> proof-modal-open;
    in-out property <float> proof-freeze: -1;
    out property <ProofRect> proof-form: proof.form-rect;
    out property <ProofRect> proof-list: proof.list-rect;
    out property <ProofRect> proof-panel: proof.panel-rect;
    out property <ProofRect> proof-modal: proof.modal-rect;
    out property <float> proof-progress: proof.progress;
    out property <float> proof-scroll: proof.scroll;
    callback proof-submit(string, string);
    callback proof-images();
    callback proof-wheel(float);
    callback proof-start();
    title: "RDI Slint Prototype";
    preferred-width: 1280px; preferred-height: 720px; min-width: 800px; min-height: 600px;
    no-frame: true; background: transparent;
    default-font-family: "OPPO Sans 4.0";
    /// Background and glass, rendered with wgpu before each frame (see glass/mod.rs).
    in property <image> backdrop;
    /// The backdrop texture is redrawn in place, so its image never changes. Raising this tells
    /// Slint the pixels did; otherwise the rounded window's cached layer keeps showing old ones.
    in property <int> backdrop-revision;
    in property <[TileData]> hosts;
    in property <[TileData]> modpacks;
    in property <string> player-name: "未登录";
    in-out property <bool> account-menu;
    callback logout();
    in property <image> player-head;
    in property <string> error;
    in property <string> page-error;
    in property <bool> loading: true;
    in property <bool> loading-more;
    in property <bool> show-others;
    in property <int> online-count;
    in property <int> selected: 0;
    in-out property <length> host-scroll: 0px;
    in-out property <length> modpack-scroll: 0px;
    in property <int> host-pressed: -1;
    in property <int> modpack-pressed: -1;
    in property <float> host-scale: 1;
    in property <float> modpack-scale: 1;
    out property <float> tab-position: root.selected;
    animate tab-position { duration: 350ms; easing: cubic-bezier(0.4,0,0.2,1); }
    out property <float> logical-width: self.width / 1px;
    out property <float> logical-height: self.height / 1px;
    out property <float> grid-y: 40 + (self.height / 1px - 40 - 434) / 2;
    callback window-action(int);
    callback window-resize(int);
    in property <bool> window-maximized;
    callback select-tab(int);
    callback toggle-others();
    callback tile-hover(int,int,bool);
    callback tile-press(int,int,bool);
    callback tile-action(int,int,bool);
    callback pill-press(int,bool,float,float);
    callback scroll-changed();
    callback retry();
    callback retry-page();
    callback stub(string);
    changed modal-open => { if root.modal-open {dialog.focus-dialog();} else if root.login-visible {login-view.focus-account();} else {shell-focus.focus();} }
    changed logical-width => {root.scroll-changed();}
    forward-focus: shell-focus;
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        border-radius: root.window-maximized ? 0px : 24px;
        clip: true;
    shell-focus := FocusScope { x: 0px; y: 0px; width: root.width; height: root.height;
        key-pressed(e) => {
            if e.text == Key.Escape && root.account-menu {root.account-menu = false; return accept;}
            if e.text == Key.Escape {root.navigate("back"); return accept;}
            if e.modifiers.alt && e.text == Key.LeftArrow {root.navigate("back"); return accept;}
            return reject;
        }
    Image { width: parent.width; height: parent.height; source: root.backdrop-revision >= 0 ? root.backdrop : root.backdrop; image-fit: fill; }
    title-bar := TitleBar { y: 0px; width: parent.width; player-name: root.player-name; head: root.player-head; account => {if !root.login-visible {root.account-menu = !root.account-menu;}} action(a) => {root.window-action(a);} stub(s) => {root.stub(s);} can-back: root.can-back; gallery-enabled: root.gallery-enabled; navigate(s) => {root.navigate(s);} }
    menu := FocusScope { x: 0px; y: 40px; width: parent.width; height: parent.height - 40px; visible: !root.login-visible && !root.ui-proof && !root.gallery && root.pack-screen == 0; enabled: !root.modal-open && root.activity-panel == 0;
    tabs := GlassTabBar { x: (parent.width - self.width) / 2; y: 16px; tab-position: root.tab-position; selected: root.selected; select(t) => {root.select-tab(t);} press(i,on,x,y) => {root.pill-press(i,on,x,y);} }
    Rectangle { y: root.grid-y * 1px - 40px; width: parent.width; height: 434px; clip: true;
        host-grid := TileGrid { visible: !root.loading && root.error == "" && root.tab-position < 1; x: -root.tab-position * root.width; width: root.width; tiles: root.hosts; scroll <=> root.host-scroll; fade: 1 - root.tab-position;
            // `opacity` here would render the whole scrollable grid through one huge offscreen layer;
            // tiles fade their leaves instead, and a fully faded grid is hidden.

            pressed: root.host-pressed; press-scale: root.host-scale;
            hover(i,on) => {root.tile-hover(0,i,on);} press(i,on) => {root.tile-press(0,i,on);} action(i,r) => {root.tile-action(0,i,r);} moved => {root.scroll-changed();}
        }
        pack-grid := TileGrid { visible: !root.loading && !root.packs-loading && root.packs-error == "" && root.error == "" && root.tab-position > 0; x: (1 - root.tab-position) * root.width; width: root.width; tiles: root.modpacks; scroll <=> root.modpack-scroll; fade: root.tab-position;

            pressed: root.modpack-pressed; press-scale: root.modpack-scale;
            hover(i,on) => {root.tile-hover(1,i,on);} press(i,on) => {root.tile-press(1,i,on);} action(i,r) => {root.tile-action(1,i,r);} moved => {root.scroll-changed();}
        }
        if root.loading || (root.selected == 1 && root.packs-loading): Text { text: "正在加载…"; color: Theme.ink; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
        if !root.loading && !root.packs-loading && root.packs-error == "" && root.error == "" && (root.selected == 0 ? root.hosts.length == 0 : root.modpacks.length == 0): Text {
            text: root.selected == 1 ? "还没有整合包，去整合广场看看吧" : root.show-others ? "暂无可展示的房间，等待朋友邀请" : "暂无可游玩的房间，可点击显示其他房间";
            color: Theme.ink; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height;
        }
        if root.loading-more && root.selected == 0: Text { x: parent.width - 100px; y: parent.height / 2; text: "加载中…"; color: Theme.ink; }
        if root.error != "": VerticalLayout { padding: 64px; alignment: center; spacing: 16px;
            Text { text: root.error; wrap: word-wrap; horizontal-alignment: center; color: #902020; }
            GlassButton { width: 120px; label: "重试"; glyph: "\u{f021}"; clicked => {root.retry();} }
        }
    }
    HorizontalLayout { visible: root.selected == 0; x: (parent.width - 308px) / 2; y: parent.height - 60px; width: 308px; height: 36px; spacing: 12px;
        create := GlassButton { width: 128px; label: "创建房间"; glyph: "\u{f067}"; clicked => {root.stub("创建房间");} press(on,x,y) => {root.pill-press(2,on,x,y);} }
        others := GlassButton { width: 168px; label: root.show-others ? "隐藏其他房间" : "显示其他房间"; glyph: root.show-others ? "\u{f070}" : "\u{f06e}"; clicked => {root.toggle-others();} press(on,x,y) => {root.pill-press(3,on,x,y);} }
    }
    HorizontalLayout { visible: root.selected == 1; x: (parent.width - 484px) / 2; y: parent.height - 60px; width: 484px; height: 36px; spacing: 12px;
        plaza := GlassButton { width: 128px; label: "整合广场"; glyph: "\u{f19d5}"; clicked => {root.stub("整合广场");} press(on,x,y) => {root.pill-press(4,on,x,y);} }
        install := GlassButton { width: 176px; label: "整合包本地安装"; glyph: "\u{eaef}"; clicked => {root.navigate("install");} press(on,x,y) => {root.pill-press(5,on,x,y);} }
        import-pack := GlassButton { width: 156px; label: "导入rdipack2"; glyph: "\u{f019}"; clicked => {root.stub("导入rdipack2");} press(on,x,y) => {root.pill-press(6,on,x,y);} }
    }
    if root.page-error != "": GlassButton { x: 16px; y: parent.height - 100px; width: 340px; label: "房间加载失败，点击重试"; glyph: "\u{f021}"; clicked => {root.retry-page();} }
    Text { x: 16px; y: parent.height - 34px; text: "在线玩家" + root.online-count; color: #30353c; font-size: 12px; }
    }
    login-view := LoginScreen { visible: root.login-visible; enabled: !root.modal-open;
        x: (root.width - self.width) / 2; y: 40px + (root.height - 40px - self.height) / 2;
        width: min(480px, root.width - 32px); height: min(520px, root.height - 72px);
        version: root.login-version;
        account <=> root.login-account; password <=> root.login-password; saved-id <=> root.login-saved-id;
        history <=> root.login-history; busy: root.login-busy; accounts: root.login-accounts;
        submit => {root.login-submit();} select(id) => {root.login-select(id);}
        register => {root.login-register = true;} forgot => {root.stub("忘记密码");}
    }
    install-view := LocalModpackInstall { visible: root.pack-screen == 1;
        x: root.width * 0.05; y: 40px + (root.height - 40px) * 0.05; width: root.width * 0.9; height: (root.height - 40px) * 0.9; enabled: !root.modal-open && root.activity-panel == 0;
        editor: root.install-editor; loading: root.install-loading; scanning: root.install-scanning;
        can-submit: root.install-can-submit; version-selectable: root.install-version-selectable; include-saves: root.install-include-saves;
        source: root.install-source; source-directory: root.install-source-directory; error: root.install-error; progress: root.install-progress; progress-fraction: root.install-progress-fraction;
        name: root.install-name; comment: root.install-comment; icon-url: root.install-icon; size-text: root.install-size; missing-count: root.install-missing-count;
        candidates: root.install-candidates; runtimes: root.install-runtimes; runtime-index: root.install-runtime-index; contents: root.install-contents;
        action(a,v) => {if a == "back" {root.navigate("back");} else {root.pack-action("installer." + a,v);} }
        filter(q,k,d) => {root.pack-filter(q,k,d);}
    }
    options-view := ModpackLocalAdvanceOption { visible: root.pack-screen == 2;
        x: root.width * 0.05; y: 40px + (root.height - 40px) * 0.05; width: root.width * 0.9; height: (root.height - 40px) * 0.9; enabled: !root.modal-open && root.activity-panel == 0;
        title: root.options-title; loading: root.options-loading; enabled-controls: root.options-enabled;
        error: root.options-error; total-memory: root.options-total-memory; draft <=> root.options-draft;
        action(a,v) => {if a == "back" {root.navigate("back");} else {root.pack-action("options." + a,v);} }
    }
    if root.selected == 1 && root.pack-screen == 0 && root.packs-error != "": GlassButton { x: 32px; y: root.height / 2; width: root.width - 64px; label: root.packs-error + " · 重试"; clicked => {root.pack-action("packs.refresh", "");} }
    if root.game-status != "": Text { x: 180px; y: parent.height - 34px; width: parent.width - 380px; text: root.game-status; overflow: elide; color: #30353c; }
    if root.game-running: GlassButton { x: parent.width - 180px; y: parent.height - 48px; width: 160px; label: "终止游戏"; clicked => { root.stop-games(); } }
    gallery-view := ComponentGallery {
        x: 0px; y: 40px; width: parent.width; height: parent.height - 40px; visible: root.gallery; enabled: !root.modal-open;
        page <=> root.gallery-page; head: root.gallery-image; image-state: root.gallery-image-state; items: root.gallery-items; tiles: root.gallery-tiles; logs: root.gallery-logs;
        selected-log: root.gallery-selected-log; all-logs: root.gallery-log-text; tasks: root.gallery-tasks; content-state <=> root.gallery-content-state;
        filter(q,k,d) => {root.gallery-filter(q,k,d);} notify(s) => {root.notify(s);} dialog => {root.gallery-dialog = true;}
        console-action(s) => {root.console-action(s);} select-log(i) => {root.select-log(i);} toggle-task(i) => {root.toggle-task(i);}
    }
    if root.activity-panel != 0: Rectangle { x: 0px; y: 40px; width: parent.width; height: parent.height - 40px; background: #0006;
        TouchArea { clicked => {root.activity-panel = 0;} }
        // Panels are centered with a margin; a TouchArea under each keeps clicks on empty panel space from closing it.
        if root.activity-panel == 1: Rectangle { width: min(1100px, parent.width - 48px); height: parent.height - 48px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: #fafcf4f2; border-radius: 24px;
            TouchArea {}
            HorizontalLayout { x: 16px; y: 12px; width: parent.width - 32px; height: 36px; spacing: 8px;
                Text { text: "控制台"; color: Theme.ink; font-size: 18px; font-weight: 600; vertical-alignment: center; }
                // `collapsed` marks the session whose log is shown.
                for session in root.activity-sessions: GlassButton { label: session.name; checked: session.collapsed; clicked => {root.pack-action("console.select",session.detail);} }
                Rectangle { horizontal-stretch: 1; }
                CircleIconButton { glyph: "\u{f021}"; accessible-label: "刷新"; clicked => {root.pack-action("console.subscribe", "");} }
                CircleIconButton { glyph: "\u{f00d}"; accessible-label: "关闭"; clicked => {root.activity-panel = 0;} }
            }
            Console { x: 4px; y: 52px; width: parent.width - 8px; height: parent.height - 68px; background: transparent; title-visible: false;
                lines: root.activity-logs; all-text: root.activity-log-text; selected-text: root.activity-selected-log;
                export => {root.pack-action("console.export", "");} clear => {root.pack-action("console.clear", "");} select-line(i) => {root.pack-action("console.line",i);}
            }
        }
        if root.activity-panel == 2: task-panel := Rectangle {
            property <bool> has-list: root.activity-task-list.length > 1;
            width: min(self.has-list ? 1000px : 760px, parent.width - 48px); height: min(520px, parent.height - 48px);
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: #fafcf4f2; border-radius: 24px;
            TouchArea {}
            if task-panel.has-list: ListView { x: 12px; y: 16px; width: 220px; height: parent.height - 32px;
                for task in root.activity-task-list: GlassButton { height: 44px; label: task.name; clicked => {root.pack-action("tasks.watch",task.detail);} }
            }
            TaskProgress { x: task-panel.has-list ? 236px : 0px; y: 0px; width: parent.width - self.x; height: parent.height; background: transparent;
                title: root.activity-title; message: root.activity-message; error: root.activity-error; fraction: root.activity-fraction; rows: root.activity-tasks;
                toggle(i) => {root.pack-action("tasks.toggle",i);} hidden => {root.activity-panel = 0;}
            }
        }
    }

    if root.account-menu && !root.login-visible: AccountMenu {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        anchor-x: title-bar.account-x; anchor-y: 44px;
        dismiss => {root.account-menu = false;}
        player-info => {root.account-menu = false; root.stub("个人信息");}
        wardrobe => {root.account-menu = false; root.stub("衣柜");}
        logout => {root.account-menu = false; root.logout();}
    }
    if root.modal-open: Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: #0009; TouchArea {} }
    dialog := SharedDialog {
        width: min(480px, root.width - 48px);
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; visible: root.modal-open && !root.login-register && !root.local-play && !root.pack-menu && !root.discard-options && !root.install-missing && root.picked-candidates.length == 0;
        title: root.confirm-exit ? "退出启动器" : root.duplicate-host != "" ? "重复启动" : root.action-error != "" ? "错误" : "与朋友一起冒险";
        message: root.confirm-exit ? (root.tasks-running ? "任务仍在进行，退出将终止任务和正在运行的游戏。是否继续？" : "游戏仍在运行，退出将终止游戏。是否继续？") : root.duplicate-host != "" ? "该整合包已在运行。再次启动可能造成存档、配置、日志或Mod缓存冲突。是否继续？" : root.action-error != "" ? root.action-error : "准备好探索Minecraft世界了吗？这段较长的中文说明会自动换行。";
        confirm-label: root.confirm-exit ? (root.tasks-running ? "终止并退出" : "终止游戏并退出") : root.duplicate-host != "" ? "继续启动" : root.login-visible ? "明白" : "确定";
        cancel-visible: root.action-error == "";
        dismissed => {root.confirm-exit = false; root.duplicate-host = ""; root.action-error = ""; root.gallery-dialog = false;}
        confirmed => {if root.confirm-exit {root.window-action(4);} else if root.duplicate-host != "" {root.confirm-duplicate();} else {root.action-error = ""; root.gallery-dialog = false;} }
    }
    if root.login-register: Rectangle { x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; width: min(560px, root.width - 48px); height: 192px; border-radius: 24px; background: #f7faf0ff;
        VerticalLayout { padding: 24px; spacing: 16px;
            Text { text: "请选择注册方式"; font-size: 22px; color: Theme.ink; }
            HorizontalLayout { spacing: 8px;
                GlassButton { label: "用微软MC正版号注册"; filled: true; clicked => {root.login-register = false; root.stub("用微软MC正版号注册");} }
                GlassButton { label: "用QQ邮箱注册"; clicked => {root.login-register = false; root.stub("用QQ邮箱注册");} }
            }
            GlassButton { label: "取消"; clicked => {root.login-register = false;} }
        }
    }
    if root.pack-menu: Rectangle { x: (root.width - 360px) / 2; y: (root.height - 320px) / 2; width: 360px; height: 320px; background: #f7faf0f5; border-radius: 24px;
        VerticalLayout { padding: 24px; spacing: 12px;
            Text { text: root.pack-name; font-size: 22px; color: Theme.ink; overflow: elide; }
            for label[i] in ["开始游戏", "高级", "目录", "详情", "内容", "取消"]: GlassButton { label: label; clicked => {root.pack-action("menu",i);} }
        }
    }
    if root.local-play: LocalPlay { x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; width: min(560px,root.width - 48px); height: min(self.preferred-height,root.height - 48px);
        name: root.pack-name; online-available: root.play-online-available; busy: root.play-busy; device-uri: root.play-device-uri; error: root.play-error; nonstandard-name: root.play-nonstandard-name;
        nickname <=> root.play-nickname; online <=> root.play-online;
        action(a,v) => {root.pack-action("play." + a,v);}
    }
    if root.discard-options: Rectangle { x: (root.width - 520px) / 2; y: (root.height - 200px) / 2; width: 520px; height: 200px; border-radius: 24px; background: #f7faf0f5;
        VerticalLayout { padding: 24px; spacing: 16px;
            Text { text: "未保存修改"; color: Theme.ink; font-size: 22px; }
            Text { text: "要保存修改后返回吗？"; color: Theme.ink; }
            HorizontalLayout { spacing: 8px;
                GlassButton { label: "保存并返回"; clicked => {root.discard-options = false; root.pack-action("options.saveBack", "");} }
                GlassButton { label: "放弃修改"; clicked => {root.discard-options = false; root.pack-action("options.discard", "");} }
                GlassButton { label: "取消"; clicked => {root.discard-options = false;} }
            }
        }
    }
    if root.install-missing: SharedDialog { x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; width: min(560px,root.width - 48px);
        height: min(root.height - 96px, 220px + min(root.install-missing-count, 12) * 18px);
        title: "有" + root.install-missing-count + "个文件无法自动下载"; message: root.install-missing-text; confirm-label: "继续导入";
        confirmed => {root.pack-action("installer.confirmMissing", "");} dismissed => {root.pack-action("installer.dismissMissing", "");}
    }
    if root.picked-candidates.length > 0: Rectangle { x: (root.width - 560px) / 2; y: 80px; width: 560px; height: root.height - 160px; background: #f7faf0f5; border-radius: 24px;
        VerticalLayout { padding: 24px; spacing: 12px;
            Text { text: "选择要导入的版本"; font-size: 22px; color: Theme.ink; }
            ListView { for candidate in root.picked-candidates: GlassButton { height: 44px; label: candidate.name + " · " + candidate.detail; clicked => {root.pack-action("installer.pickedCandidate",candidate.index);} } }
            GlassButton { label: "取消"; clicked => {root.pack-action("installer.dismissCandidates", "");} }
        }
    }
    if root.toast-message != "": Toast { x: (parent.width - self.width) / 2; y: parent.height - 64px; width: min(560px, parent.width - 48px); message: root.toast-message; dismissed => {root.toast-message = "";} }
    proof := UiProof {
        visible: root.ui-proof; y: 40px; width: parent.width; height: parent.height - 40px;
        rows: root.proof-rows; busy: root.proof-busy; message: root.proof-message;
        panel-open <=> root.proof-panel-open; modal-open <=> root.proof-modal-open;
        freeze <=> root.proof-freeze;
        submit(u,p) => { root.proof-submit(u,p); }
        images => { root.proof-images(); }
        start => { root.proof-start(); }
        wheel(d) => { root.proof-wheel(d); }
    }
    // A maximized window cannot be resized, and its edges belong to the title controls.
    if !root.window-maximized: ResizeHandles { x: 0px; y: 0px; width: parent.width; height: parent.height; start(edge) => { root.window-resize(edge); } }

    }
    }
}
