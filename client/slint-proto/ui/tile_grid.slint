import { TileData } from "theme.slint";
import { HostTile } from "host_tile.slint";
export component TileGrid inherits Rectangle {
    in property <[TileData]> tiles;
    in-out property <length> scroll: 0px;
    in property <int> pressed: -1;
    in property <float> press-scale: 1;
    in property <float> fade: 1;
    callback hover(int,bool);
    callback press(int,bool);
    callback action(int,bool);
    callback moved();
    clip: true;
    height: 434px;
    TouchArea {
      scroll-event(e) => {
        root.scroll = clamp(root.scroll + (e.delta-x != 0px ? e.delta-x : e.delta-y), min(0px, root.width - max(root.width, ceil(root.tiles.length / 3) * 138px + 20px)), 0px);
        root.moved(); return accept;
      }
    flick := Flickable {
        width: parent.width; height: parent.height;
        interactive: false;
        content-width: max(self.width, ceil(root.tiles.length / 3) * 138px - 12px + 32px);
        content-height: self.height;
        content-x <=> root.scroll;
        for tile[i] in root.tiles: HostTile {
            x: 16px + floor(i / 3) * 138px; y: 16px + mod(i,3) * 138px;
            visible: self.x + 126px + root.scroll > -276px && self.x + root.scroll < root.width + 276px;
            tile: tile; scale: root.pressed == i ? root.press-scale : 1; fade: root.fade;
            hover(on) => {root.hover(i,on);} press(on) => {root.press(i,on);} action(right) => {root.action(i,right);}
        }
    }
    }
}
