export component PlayerHead inherits Rectangle {
    in property <image> source;
    /// Applied to each leaf instead of `opacity` here: opacity on an element with children
    /// makes femtovg render it through an offscreen layer.
    in property <float> alpha: 1;
    border-radius: self.width * 4 / 18;
    background: #faf8ff.with-alpha(root.alpha);
    Image { x: parent.width / 12; y: self.x; width: parent.width * 5 / 6; height: self.width; source: root.source; image-rendering: pixelated; opacity: root.alpha; }
}
