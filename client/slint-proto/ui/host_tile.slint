import { TileData, Theme } from "theme.slint";
import { PlayerHead } from "player_head.slint";
export component HostTile inherits Rectangle {
    in property <TileData> tile;
    in property <float> scale: 1;
    /// Tab-switch fade, multiplied into every leaf like the dimming (see the comment below).
    in property <float> fade: 1;
    property <float> alpha: (root.tile.dimmed ? 0.45 : 1) * root.fade;
    callback hover(bool);
    callback press(bool);
    callback action(bool);
    width: 126px; height: 126px;
    Rectangle { x: (parent.width - self.width) / 2; y: self.x; width: 126px * root.scale; height: self.width;
        // No rounded `clip` and no `opacity` on containers: on femtovg both render through an offscreen
        // layer per tile, which costs ~150MB with wgpu. Icons arrive with rounded corners baked in
        // (images.rs) and the dimming alpha is applied to each leaf.
        Rectangle { x: 9px * root.scale; y: self.x; width: 108px * root.scale; height: self.width;
            if root.tile.has-icon: Image { width: parent.width; height: parent.height; source: root.tile.icon; image-fit: cover; opacity: root.alpha; }
            if !root.tile.has-icon: Rectangle { width: parent.width; height: parent.height; border-radius: 13px * root.scale; background: #e2e4ed.with-alpha(root.alpha); }
            if !root.tile.has-icon: Text { width: parent.width; height: parent.height; text: root.tile.initial; color: #51597b.with-alpha(root.alpha); font-size: 36px; horizontal-alignment: center; vertical-alignment: center; }
            for head[i] in root.tile.heads: PlayerHead { x: (-3px + mod(i,5) * 20px) * root.scale; y: (-3px + floor(i/5) * 20px) * root.scale; width: 18px * root.scale; height: self.width; source: head; alpha: root.alpha; }
            if root.tile.has-owner: PlayerHead { x: parent.width - self.width + 3px * root.scale; y: parent.height - self.height + 3px * root.scale; width: 27px * root.scale; height: self.width; source: root.tile.owner; alpha: root.alpha; }
        }
        if root.tile.status > 0: Rectangle { x: parent.width - 19px; y: 3px; width: 16px; height: 16px; border-radius: 8px; background: (root.tile.status == 1 ? #3ddc84 : #ffc107).with-alpha(0.25 * root.fade);
            Rectangle { x: 3px; y: 3px; width: 10px; height: 10px; border-radius: 5px; background: #faf8ff.with-alpha(root.fade);
                Rectangle { x: 1.5px; y: 1.5px; width: 7px; height: 7px; border-radius: 3.5px; background: (root.tile.status == 1 ? #3ddc84 : #ffc107).with-alpha(root.fade); }
            }
        }
    }
    touch := TouchArea { mouse-cursor: pointer; changed has-hover => {root.hover(self.has-hover);} pointer-event(e) => {
        if e.button == PointerEventButton.left {root.press(e.kind == PointerEventKind.down);}
        if e.kind == PointerEventKind.up {root.action(e.button == PointerEventButton.right);}
        if e.kind == PointerEventKind.cancel {root.press(false);}
    } }
}
