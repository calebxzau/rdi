import { GlassButton } from "glass_button.slint";
export component GlassTabBar inherits Rectangle {
    in property <int> selected;
    callback select(int);
    callback press(int,bool,float,float);
    width: 292px; height: 56px;
    GlassButton { x: 6px; y: 6px; width: 154px; height: 44px; label: "多人房间"; glyph: "\u{f0c0}"; clicked => {root.select(0);} press(on,x,y) => {root.press(0,on,x,y);} }
    GlassButton { x: 164px; y: 6px; width: 122px; height: 44px; label: "整合包"; glyph: "\u{f1b2}"; clicked => {root.select(1);} press(on,x,y) => {root.press(1,on,x,y);} }
}
