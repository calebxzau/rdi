{
  "schemaVersion": 1,
  "id": "rdi",
  "version": "${version}",
  "name": "RDI",
  "description": "RDI Minecraft client support for Fabric 1.20.1",
  "authors": ["calebxzhou"],
  "license": "GPL-3.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "calebxzau.rdi.mc.v20.fabric.RDIFabricClient"
    ]
  },
  "mixins": [
    "rdi.fabric.mixins.json",
    "rdi.fabric.media.mixins.json",
    "rdi.v20.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-resource-loader-v0": ">=0.11.12",
    "fabric-networking-api-v1": "1.3.15+0caff8d077",
    "fabric-api-base": "0.4.32+1802ada577",
    "fabric-lifecycle-events-v1": "2.2.23+1802ada577",
    "fabric-language-kotlin": ">=1.13",
    "minecraft": "1.20.1",
    "java": ">=25"
  }
}
